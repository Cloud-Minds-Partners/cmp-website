---
import "../styles/global.css";
import WhatsAppFab from "../components/WhatsAppFab.astro";

interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <!-- Send the Firebase default domains to the canonical site. cmp-website.web.app
         and www.cloudmindspartners.com are the SAME hosting site, so the .web.app
         host cannot be deleted without taking down www — it is redirected instead. -->
    <script is:inline>
      (function () {
        var h = location.hostname;
        if (h === "cmp-website.web.app" || h === "cmp-website.firebaseapp.com") {
          location.replace(
            "https://www.cloudmindspartners.com" +
              location.pathname + location.search + location.hash
          );
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#05111D" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Per-page SEO meta (title, description, OG, canonical, hreflang) injected via SEO.astro -->
    <slot name="head" />
  </head>
  <body>
    <!-- Skip-to-content: visible on focus for keyboard/AT users -->
    <a href="#main" class="skip-link">Skip to content</a>
    <div id="main">
      <slot />
    </div>
    <WhatsAppFab />

    <script is:inline>
      // Mobile burger menu — auto-injects from existing .nav-links
      (function () {
        const nav = document.querySelector('nav.nav .nav-inner');
        if (!nav) return;
        const navLinks = nav.querySelector('.nav-links');
        const navRight = nav.querySelector('.nav-right');
        const langEl = navRight ? navRight.querySelector('.nav-lang') : null;
        const ctaEl = navRight ? navRight.querySelector('.nav-cta') : null;
        if (!navLinks || !navRight) return;

        // Build burger button
        const burger = document.createElement('button');
        burger.className = 'nav-burger';
        burger.setAttribute('aria-label', 'Menu');
        burger.setAttribute('aria-expanded', 'false');
        burger.innerHTML = '<span class="nav-burger-icon"><span></span><span></span><span></span></span>';
        navRight.appendChild(burger);

        // Build mobile menu drawer
        const drawer = document.createElement('div');
        drawer.className = 'nav-mobile';
        const linksClone = navLinks.cloneNode(true);
        Array.from(linksClone.children).forEach(a => drawer.appendChild(a));
        const footer = document.createElement('div');
        footer.className = 'nav-mobile-footer';
        if (langEl) {
          const langClone = langEl.cloneNode(true);
          langClone.className = 'nav-mobile-lang';
          // Remove dot separators
          langClone.querySelectorAll('.sep').forEach(s => s.remove());
          footer.appendChild(langClone);
        }
        if (ctaEl) {
          const ctaClone = ctaEl.cloneNode(true);
          ctaClone.className = 'nav-mobile-cta';
          footer.appendChild(ctaClone);
        }
        drawer.appendChild(footer);
        nav.parentNode.appendChild(drawer);

        // Toggle
        burger.addEventListener('click', function () {
          const isOpen = burger.classList.toggle('open');
          drawer.classList.toggle('open', isOpen);
          document.body.classList.toggle('nav-mobile-open', isOpen);
          burger.setAttribute('aria-expanded', String(isOpen));
        });
        // Close on link click
        drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
          burger.classList.remove('open');
          drawer.classList.remove('open');
          document.body.classList.remove('nav-mobile-open');
        }));
        // Close on Escape
        document.addEventListener('keydown', e => {
          if (e.key === 'Escape' && drawer.classList.contains('open')) {
            burger.classList.remove('open');
            drawer.classList.remove('open');
            document.body.classList.remove('nav-mobile-open');
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 0;
    z-index: 9999;
    padding: 12px 24px;
    background: #4A8FE7;
    color: #FAFBFD;
    font-family: system-ui, sans-serif;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    border-bottom-right-radius: 6px;
    transition: top 0.1s;
  }

  .skip-link:focus {
    top: 0;
    outline: 2px solid #FAFBFD;
    outline-offset: -4px;
  }
</style>
