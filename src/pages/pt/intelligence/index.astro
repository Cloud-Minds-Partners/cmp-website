---
import Base from '../../../layouts/Base.astro';
import SEO from '../../../components/SEO.astro';

const pulses = [
  { num: '10', date: '16 Jun', dateIso: '2026-06-16', tag: 'Orbital · LatAm', title: "Compute leaves Earth.", summary: 'Quatro sinais que moveram o mercado de data centers.', cover: '/photos/pulse-10-cover.png', featured: true },
  { num: '09', date: '9 Jun',  dateIso: '2026-06-09', tag: 'Brasil · Rede', title: "Brazilian grid sets the terms.", summary: 'Três sinais que moveram o mercado de data centers.', cover: '/photos/pulse-09-cover.png' },
  { num: '08', date: '2 Jun',  dateIso: '2026-06-02', tag: 'LatAm · Capital', title: "Latin America's $17.6B buildout.", summary: 'Dois sinais que moveram o mercado de data centers.', cover: '/photos/pulse-08-cover.png' },
  { num: '07', date: '26 Mai', dateIso: '2026-05-26', tag: 'Energia · Regulatório', title: "Brazil's wind goes hyperscale.", summary: 'Quatro sinais que moveram o mercado de data centers.', cover: '/photos/pulse-07-cover.png' },
  { num: '06', date: '19 Mai', dateIso: '2026-05-19', tag: 'Energia', title: 'Google heads off Earth.', summary: 'Quatro sinais que moveram o mercado de data centers.', cover: '/photos/pulse-06-cover.png' },
  { num: '05', date: '12 Mai', dateIso: '2026-05-12', tag: 'Grid · Regulatório', title: 'Chile clears. Europe waits.', summary: 'Unlock AWS Atacama vs pausa Energinet. A geografia da liberação mudou.' },
  { num: '04', date: '5 Mai',  dateIso: '2026-05-05', tag: 'Capital', title: 'From frontier to allocated.', summary: 'I Squared adquire Elea. Big Four projeta US$ 725B capex 2026. Brasil cruza 1 GW.' },
  { num: '03', date: '28 Abr', dateIso: '2026-04-28', tag: 'Energia · Fronteira', title: 'A rede não é mais o único caminho.', summary: 'Bloom Energy, Meta + Overview Energy solar orbital, Equinix SP6 em São Paulo.' },
  { num: '02', date: '21 Abr', dateIso: '2026-04-21', tag: 'Mercados · LatAm', title: 'Tecto aposta US$ 2B na LatAm.', summary: 'Plataforma brasileira projeta expansão regional até 2028. Wyoming emerge como nova fronteira tier-1.' },
  { num: '01', date: '13 Abr', dateIso: '2026-04-13', tag: 'Macro', title: 'A semana em data centers globais.', summary: 'Leilão emergencial PJM 15 GW, deal Meta + CoreWeave US$ 21B, REIT DC da Blackstone.' },
];

const featured = pulses[0];
const archive = pulses;
const linkedinUrl = 'https://www.linkedin.com/company/cloud-minds-partners/posts/';
import LegalEntity from "../../../components/LegalEntity.astro";
---

<Base lang="pt">
  <SEO
    slot="head"
    title="Inteligência — Cloud Minds Partners"
    description="DC Weekly Pulse e linhas de pesquisa sobre o mercado de data centers LatAm. Fontes primárias, auditado claim a claim."
    image="/og/intelligence.png"
  />

  <style slot="head" is:global>
    .page-hero-bg { background-image: url("/photos/hero-intelligence.jpg"); filter: saturate(1.1) contrast(1.05) brightness(0.85); }

    .streams { background: var(--navy-1); border-bottom: 1px solid var(--line-0); position: sticky; top: 72px; z-index: 30; }
    .streams-inner { display: flex; max-width: var(--max-w); margin: 0 auto; }
    .streams-tab { padding: 18px clamp(20px, 3vw, 36px); font-size: 15px; color: var(--cream-1); font-weight: 600; font-family: var(--font-display); letter-spacing: -0.005em; border-right: 1px solid var(--line-0); transition: background var(--t-fast), color var(--t-fast); position: relative; cursor: pointer; }
    .streams-tab:first-child { border-left: 1px solid var(--line-0); margin-left: var(--gutter); }
    .streams-tab:hover { background: var(--navy-2); color: var(--cream-0); }
    .streams-tab.active { color: var(--cream-0); background: var(--navy-2); }
    .streams-tab.active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: var(--blue-bright); }
    .streams-badge { display: inline-block; margin-left: 10px; font-family: var(--font-body); font-size: 10.5px; font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase; padding: 3px 8px; border-radius: 999px; vertical-align: middle; }
    .streams-badge.live { background: rgba(74,222,128,0.12); color: #4ADE80; border: 1px solid rgba(74,222,128,0.35); }
    .streams-badge.dev { background: rgba(148,163,184,0.10); color: #94a3b8; border: 1px solid rgba(148,163,184,0.30); }

    .pulse-section { background: var(--cream-bg); color: var(--navy-0); padding: clamp(72px, 10vh, 120px) 0; border-top: 1px solid rgba(5,14,29,0.06); }
    .pulse-inner { max-width: var(--max-w); margin: 0 auto; padding: 0 var(--gutter); }
    .pulse-featured { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(48px, 6vw, 96px); align-items: center; }
    .pulse-cover-frame { aspect-ratio: 1/1; position: relative; overflow: hidden; border: 1px solid rgba(5,14,29,0.08); border-radius: 12px; background: #0a1d3a; box-shadow: 0 24px 48px rgba(5,14,29,0.12); }
    .pulse-cover-frame img { width: 100%; height: 100%; object-fit: cover; }
    .pulse-cover-tag { position: absolute; bottom: 18px; right: 18px; z-index: 2; font-family: var(--font-body); font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #fff; background: #0d9488; padding: 8px 14px; border-radius: 999px; box-shadow: 0 6px 18px rgba(13,148,136,0.45); }
    .pulse-eyebrow { font-family: var(--font-body); font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--blue-deep); display: inline-flex; align-items: center; gap: 10px; }
    .pulse-eyebrow::before { content: ""; width: 22px; height: 1px; background: var(--blue-deep); }
    .pulse-title { font-family: var(--font-display); font-size: clamp(28px, 3.4vw, 44px); line-height: 1.05; letter-spacing: var(--track-display); font-weight: 600; margin: 16px 0 0; color: var(--navy-0); max-width: 14ch; }
    .pulse-summary { margin: 22px 0 0; font-size: 16px; line-height: 1.6; color: #4D5F7A; max-width: 500px; }
    .pulse-meta { margin-top: 28px; display: flex; gap: 28px; padding-top: 20px; border-top: 1px solid rgba(5,14,29,0.10); font-family: var(--font-body); font-size: 12.5px; color: #59677D; }
    .pulse-meta strong { display: block; color: var(--navy-0); font-weight: 600; font-size: 14px; margin-bottom: 4px; }
    .pulse-cta { display: inline-flex; align-items: center; gap: 12px; margin-top: 28px; font-size: 14px; font-weight: 600; color: var(--blue); padding-bottom: 4px; border-bottom: 1px solid var(--blue); transition: gap var(--t-fast); }
    .pulse-cta:hover { gap: 18px; color: var(--navy-0); }

    .pulse-archive { margin-top: clamp(80px, 10vh, 120px); }
    .pulse-archive-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 32px; }
    .pulse-archive-header h2 { font-family: var(--font-display); font-size: clamp(22px, 2.6vw, 32px); margin: 0; letter-spacing: var(--track-display); color: var(--navy-0); font-weight: 600; }
    .pulse-archive-header-count { font-family: var(--font-body); font-size: 13px; color: #59677D; letter-spacing: 0; }
    .pulse-archive-grid { display: flex; flex-direction: column; border-top: 1px solid rgba(5,14,29,0.10); }
    .pulse-row { display: grid; grid-template-columns: 88px 1fr 160px; gap: clamp(20px, 2.6vw, 40px); padding: 24px 12px; border-bottom: 1px solid rgba(5,14,29,0.08); transition: background var(--t-fast); align-items: center; }
    .pulse-row:hover { background: rgba(5,14,29,0.03); }
    .pulse-row-num { font-family: var(--font-display); font-size: 13px; font-weight: 600; color: #59677D; letter-spacing: 0; }
    .pulse-row-num strong { display: block; font-family: var(--font-display); font-size: 22px; font-weight: 600; color: var(--navy-0); letter-spacing: -0.012em; margin-bottom: 2px; }
    .pulse-row-body h3 { font-family: var(--font-display); font-size: 17px; font-weight: 600; letter-spacing: -0.008em; margin: 0 0 6px; color: var(--navy-0); }
    .pulse-row-body p { font-size: 13.5px; line-height: 1.55; color: #4D5F7A; margin: 0; max-width: 620px; }
    .pulse-row-tag { display: inline-block; font-family: var(--font-body); font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--blue-deep); padding: 3px 8px; border: 1px solid rgba(45,107,228,0.25); border-radius: 999px; margin-top: 10px; background: rgba(45,107,228,0.04); }
    .pulse-row-action { text-align: right; font-family: var(--font-body); font-size: 13px; color: var(--blue); font-weight: 600; }

    .streams-stack { background: var(--navy-0); padding: clamp(72px, 10vh, 120px) 0; }
    .stream-card { max-width: var(--max-w); margin: 0 auto clamp(32px, 4vh, 48px); padding: 0 var(--gutter); }
    .stream-card-inner { display: grid; grid-template-columns: 1fr 320px; gap: clamp(32px, 4vw, 64px); align-items: center; padding: 40px clamp(28px, 3vw, 48px); border: 1px solid var(--line-0); border-radius: 16px; background: linear-gradient(180deg, rgba(255,255,255,0.02) 0%, transparent 100%); }
    .stream-card-tag { font-family: var(--font-body); font-size: 11px; font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase; color: #94a3b8; background: rgba(148,163,184,0.08); border: 1px solid rgba(148,163,184,0.25); padding: 4px 10px; border-radius: 999px; display: inline-flex; align-items: center; gap: 6px; }
    .stream-card-tag::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: #94a3b8; }
    .stream-card h3 { font-family: var(--font-display); font-size: clamp(22px, 2.6vw, 32px); font-weight: 600; letter-spacing: -0.012em; margin: 18px 0 14px; color: var(--cream-0); }
    .stream-card p { font-size: 15px; line-height: 1.6; color: var(--cream-1); margin: 0; max-width: 56ch; }
    .stream-card-cta-block { display: flex; flex-direction: column; gap: 12px; padding-left: clamp(0px, 3vw, 32px); border-left: 1px solid var(--line-0); }
    .stream-card-cta-label { font-family: var(--font-body); font-size: 11.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cream-3); }
    .stream-card-cta { display: inline-flex; align-items: center; gap: 10px; padding: 12px 18px; background: var(--blue-bright); color: var(--navy-0); border-radius: 999px; font-size: 14px; font-weight: 600; transition: gap var(--t-fast); }
    .stream-card-cta:hover { gap: 16px; }

    @media (max-width: 880px) {
      .pulse-featured { grid-template-columns: 1fr; }
      .pulse-row { grid-template-columns: 1fr; }
      .pulse-row-action { text-align: left; }
      .stream-card-inner { grid-template-columns: 1fr; }
      .stream-card-cta-block { padding-left: 0; border-left: 0; border-top: 1px solid var(--line-0); padding-top: 20px; }
      .streams-inner { overflow-x: auto; }
    }
  </style>

  <nav class="nav">
    <div class="nav-inner">
      <a class="brand" href="/pt/"><img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" /></a>
      <div class="nav-links"><a href="/pt/advisory">Consultoria</a><a href="/pt/development">Desenvolvimento</a><a href="/pt/intelligence" class="active">Inteligência</a><a href="/pt/platforms">Plataformas</a><a href="/pt/team">Equipe</a><a href="/pt/contact">Contato</a></div>
      <div class="nav-right"><div class="nav-lang">
        <a href="/intelligence">EN</a><span class="sep">·</span><a href="/pt/intelligence" class="active">PT</a><span class="sep">·</span><a href="/es/intelligence">ES</a>
      </div>
      <a href="mailto:info@cloudmindspartners.com" class="nav-cta">Fale conosco <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg></a></div>
    </div>
  </nav>

  <header class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="page-hero-overlay" aria-hidden="true"></div>
    <div class="wrap">
      <div class="page-hero-content">
        <div class="page-eyebrow live">Inteligência</div>
        <h1>Pesquisa sobre o mercado <em>LatAm</em> de data centers.</h1>
        <p>Quatro streams. Fontes primárias. Auditado claim a claim.</p>
      </div>
    </div>
  </header>

  <div class="streams">
    <div class="streams-inner">
      <a class="streams-tab active" href="#pulse">Weekly Pulse <span class="streams-badge live">Live</span></a>
      <a class="streams-tab" href="#memos">Memos Técnicos <span class="streams-badge dev">Em breve</span></a>
      <a class="streams-tab" href="#radar">Innovation Radar <span class="streams-badge dev">Em breve</span></a>
      <a class="streams-tab" href="#regwatch">Regulatory Watch <span class="streams-badge dev">Em breve</span></a>
    </div>
  </div>

  <section class="pulse-section" id="pulse">
    <div class="pulse-inner">
      <div class="pulse-featured reveal">
        <div class="pulse-cover-frame">
          <img src={featured.cover} alt={`Capa DC Weekly Pulse #${featured.num}`} loading="lazy" />
          <span class="pulse-cover-tag">Pulse {featured.num} · Esta semana</span>
        </div>
        <div>
          <div class="pulse-eyebrow">Última · Weekly Pulse</div>
          <h2 class="pulse-title">{featured.title}</h2>
          <p class="pulse-summary">{featured.summary}</p>
          <div class="pulse-meta">
            <span><strong>Pulse {featured.num}</strong>{featured.date}, 2026</span>
            <span><strong>{featured.tag}</strong>Categoria</span>
            <span><strong>~1 min</strong>Para assistir</span>
          </div>
          <a href={linkedinUrl} class="pulse-cta" target="_blank" rel="noopener">
            Assistir no LinkedIn
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg>
          </a>
        </div>
      </div>

      <div class="pulse-archive">
        <div class="pulse-archive-header">
          <h2>Arquivo</h2>
          <span class="pulse-archive-header-count">{archive.length} edições · publicação semanal</span>
        </div>
        <div class="pulse-archive-grid">
          {archive.map((p) => (
            <a class="pulse-row reveal" href={linkedinUrl} target="_blank" rel="noopener">
              <div class="pulse-row-num">
                <strong>#{p.num}</strong>{p.date}
              </div>
              <div class="pulse-row-body">
                <h3>{p.title}</h3>
                <p>{p.summary}</p>
                <span class="pulse-row-tag">{p.tag}</span>
              </div>
              <div class="pulse-row-action">Assistir no LinkedIn →</div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="streams-stack">
    <div class="stream-card" id="memos">
      <div class="stream-card-inner reveal">
        <div>
          <span class="stream-card-tag">Em desenvolvimento</span>
          <h3>Memos Técnicos</h3>
          <p>Briefings de pesquisa primária em múltiplas páginas sobre desenvolvimentos regulatórios, fiscais e de grid que moldam o investimento em data centers LatAm. Cada memo auditado claim a claim antes da publicação.</p>
        </div>
        <div class="stream-card-cta-block">
          <div class="stream-card-cta-label">Me avise quando o primeiro memo publicar</div>
          <a href="/pt/contact" class="stream-card-cta">
            Quero saber
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="stream-card" id="radar">
      <div class="stream-card-inner reveal">
        <div>
          <span class="stream-card-tag">Em desenvolvimento</span>
          <h3>Innovation Radar</h3>
          <p>Sinais semanais de tecnologia e mercado para profissionais de DC LatAm — infraestrutura, IA, movimentos competitivos e shifts regulatórios. Destilado para o que importa.</p>
        </div>
        <div class="stream-card-cta-block">
          <div class="stream-card-cta-label">Receba a primeira edição</div>
          <a href="/pt/contact" class="stream-card-cta">
            Quero saber
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="stream-card" id="regwatch">
      <div class="stream-card-inner reveal">
        <div>
          <span class="stream-card-tag">Em desenvolvimento</span>
          <h3>Regulatory Watch</h3>
          <p>Digest mensal das mudanças regulatórias que afetam investimento em data centers LatAm — em sete jurisdições. Permitting, tributário, telecom, ambiental.</p>
        </div>
        <div class="stream-card-cta-block">
          <div class="stream-card-cta-label">Assinar o digest</div>
          <a href="/pt/contact" class="stream-card-cta">
            Quero saber
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <div class="foot-links">
      <div class="foot-brand-cell">
        <a class="brand" href="/pt/"><img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" /></a>
        <p>A firma de inteligência DC da América Latina.</p>
        <div class="foot-social" aria-label="Siga-nos">
          <a class="social-linkedin" href="https://www.linkedin.com/company/cloud-minds-partners" aria-label="LinkedIn" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg></a>
          <a class="social-whatsapp" href="https://wa.me/5511915788796" aria-label="WhatsApp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></a>
        </div>
      </div>
      <div><h3>Plataformas</h3><ul><li><a href="/pt/platforms">Site Screening Tool</a></li><li><a href="/pt/platforms">Grid Intelligence</a></li><li><a href="/pt/platforms">DC Insights</a></li><li><a href="/pt/platforms">DC Test Fit Pro</a></li><li><a href="/pt/platforms">DC Financial Model</a></li></ul></div>
      <div><h3>Inteligência</h3><ul><li><a href="/pt/intelligence#pulse">Weekly Pulse</a></li><li><a href="/pt/intelligence#memos">Memos Técnicos</a></li><li><a href="/pt/intelligence#radar">Innovation Radar</a></li><li><a href="/pt/intelligence#regwatch">Regulatory Watch</a></li></ul></div>
      <div><h3>Empresa</h3><ul><li><a href="/pt/advisory">Consultoria</a></li><li><a href="/pt/development">Desenvolvimento</a></li><li><a href="/pt/team">Equipe</a></li><li><a href="/pt/contact">Contato</a></li></ul></div>
      <div><h3>Contato</h3><ul><li><a href="mailto:info@cloudmindspartners.com">info@cloudmindspartners.com</a></li><li><a href="tel:+5511915788796">+55 11 91578-8796</a></li><li>São Paulo · BR</li><li>Santiago · CL</li><li>Cidade do México · MX</li></ul></div>
    </div>
    <LegalEntity />
    <div class="foot-bottom"><span>© 2026 Cloud Minds Partners</span><span>Todos os direitos reservados.</span></div>
  </footer>

  <script is:inline>
    const observer = new IntersectionObserver((entries) => { entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }); }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</Base>
