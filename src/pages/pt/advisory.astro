---
import Base from '../../layouts/Base.astro';
import SEO from '../../components/SEO.astro';
import LegalEntity from "../../components/LegalEntity.astro";
---

<Base lang="pt">
  <SEO
    slot="head"
    title="Consultoria — Cloud Minds Partners"
    description="Estratégia e diligência antes do capital e da obra. Site, energia, regulatório, business advisory — testados em toda a LatAm."
    image="/og/advisory.png"
  />

  <style slot="head" is:global>
    .page-hero-bg { background-image: url("/photos/hero-advisory.jpg"); }

    .figures-inner {
      display: grid; grid-template-columns: repeat(4, 1fr);
      max-width: none; width: 100%;
      padding: 64px clamp(28px, 4vw, 64px);
      gap: 0;
    }
    .figure {
      padding: 8px 32px;
      border-right: 1px solid rgba(255,255,255,0.06);
      text-align: center;
    }
    .figure:last-child { border-right: 0; }
    .figure-num { font-family: var(--font-display); font-size: clamp(34px, 3.6vw, 48px); line-height: 1; font-weight: 600; letter-spacing: var(--track-tight); color: var(--cream-0); }
    .figure-unit { font-size: 13px; color: var(--cream-2); font-weight: 400; font-family: var(--font-body); margin-left: 4px; }
    .figure-label { margin-top: 12px; font-family: var(--font-body); font-size: 12.5px; letter-spacing: 0; color: var(--cream-2); }

    @media (max-width: 880px) {
      .figures-inner { grid-template-columns: 1fr 1fr; gap: 28px; padding: 40px var(--gutter); }
      .figure { border-right: 0; border-bottom: 1px solid rgba(255,255,255,0.06); padding: 16px 0; }
    }

    .engagement-timeline {
      position: relative;
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 0;
      margin-top: 80px;
    }
    .engagement-line {
      position: absolute;
      top: 36px;
      left: calc(12.5% + 36px);
      right: calc(12.5% + 36px);
      height: 2px;
      background: linear-gradient(90deg, rgba(74,143,231,0.20) 0%, var(--blue-bright) 50%, rgba(74,143,231,0.20) 100%);
      z-index: 0;
    }
    .eng-step {
      position: relative;
      display: flex; flex-direction: column; align-items: center;
      padding: 0 20px;
      text-align: center;
    }
    .eng-step-circle {
      width: 72px; height: 72px;
      border-radius: 50%;
      background: var(--navy-1);
      border: 2px solid var(--blue-bright);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-display);
      font-size: 22px; font-weight: 600; letter-spacing: var(--track-tight);
      color: var(--blue-bright);
      position: relative; z-index: 2;
      box-shadow: 0 0 0 8px var(--navy-0), 0 8px 24px rgba(74,143,231,0.28);
      transition: background var(--t-base), transform var(--t-base);
    }
    .eng-step:hover .eng-step-circle { transform: translateY(-3px); }
    .eng-step.c1 .eng-step-circle { border-color: #4A8FE7; color: #4A8FE7; box-shadow: 0 0 0 8px var(--navy-0), 0 8px 24px rgba(74,143,231,0.32); }
    .eng-step.c2 .eng-step-circle { border-color: #14B8A6; color: #14B8A6; box-shadow: 0 0 0 8px var(--navy-0), 0 8px 24px rgba(20,184,166,0.32); }
    .eng-step.c3 .eng-step-circle { border-color: #F59E0B; color: #F59E0B; box-shadow: 0 0 0 8px var(--navy-0), 0 8px 24px rgba(245,158,11,0.32); }
    .eng-step.c4 .eng-step-circle { border-color: #4ADE80; color: #4ADE80; box-shadow: 0 0 0 8px var(--navy-0), 0 8px 24px rgba(74,222,128,0.32); }
    .eng-step.c1:hover .eng-step-circle { background: #4A8FE7; color: var(--navy-0); }
    .eng-step.c2:hover .eng-step-circle { background: #14B8A6; color: var(--navy-0); }
    .eng-step.c3:hover .eng-step-circle { background: #F59E0B; color: var(--navy-0); }
    .eng-step.c4:hover .eng-step-circle { background: #4ADE80; color: var(--navy-0); }
    .eng-step h4 {
      margin: 26px 0 10px;
      font-family: var(--font-display);
      font-size: 22px; font-weight: 600; letter-spacing: -0.012em;
      color: var(--cream-0);
    }
    .eng-step p {
      margin: 0 0 18px;
      font-size: 14px; line-height: 1.55;
      color: var(--cream-1);
      max-width: 30ch;
    }
    .eng-step-output {
      margin-top: auto;
      padding-top: 16px;
      border-top: 1px solid rgba(255,255,255,0.08);
      width: 80%;
      font-family: var(--font-body);
      font-size: 13px;
      color: var(--cream-0);
      letter-spacing: 0; line-height: 1.4;
    }
    .eng-step-output strong {
      display: block;
      font-size: 10.5px; font-weight: 700;
      letter-spacing: 0.10em; text-transform: uppercase;
      color: var(--cream-3);
      margin-bottom: 6px;
    }

    @media (max-width: 980px) {
      .engagement-timeline { grid-template-columns: repeat(2, 1fr); gap: 56px 0; }
      .engagement-line { display: none; }
    }
    @media (max-width: 560px) {
      .engagement-timeline { grid-template-columns: 1fr; }
    }
  </style>

  <nav class="nav">
    <div class="nav-inner">
      <a class="brand" href="/pt/">
        <img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" />
        <span class="brand-tag">A firma de inteligência DC da América Latina.</span>
      </a>
      <div class="nav-links">
        <a href="/pt/advisory" class="active">Consultoria</a>
        <a href="/pt/development">Desenvolvimento</a>
        <a href="/pt/intelligence">Inteligência</a>
        <a href="/pt/platforms">Plataformas</a>
        <a href="/pt/team">Equipe</a><a href="/pt/contact">Contato</a>
      </div>
      <div class="nav-right">
        <div class="nav-lang">
          <a href="/advisory">EN</a><span class="sep">·</span><a href="/pt/advisory" class="active">PT</a><span class="sep">·</span><a href="/es/advisory">ES</a>
        </div>
        <a href="mailto:info@cloudmindspartners.com" class="nav-cta">Fale conosco
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </nav>

  <header class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="page-hero-overlay" aria-hidden="true"></div>
    <div class="wrap">
      <div class="page-hero-content">
        <div class="page-eyebrow live">Consultoria</div>
        <h1>Antes do term sheet. <em>Antes da EPC.</em></h1>
        <p>Diligência institutional-grade para projetos de data center LatAm — seis lentes aplicadas antes do capital e da obra se comprometerem.</p>
      </div>
    </div>
  </header>

  <section class="sec-near">
    <div class="figures-inner">
      <div class="figure"><div class="figure-num">76</div><div class="figure-label">Cidades pontuadas</div></div>
      <div class="figure"><div class="figure-num">251</div><div class="figure-label">Listagens de terra</div></div>
      <div class="figure"><div class="figure-num">508</div><div class="figure-label">Estudos de grid</div></div>
      <div class="figure"><div class="figure-num">8</div><div class="figure-label">Mercados LatAm</div></div>
    </div>
  </section>

  <section class="sec-cream sec-pad on-cream">
    <div class="wrap">
      <div class="reveal" style="text-align:center; margin-bottom: 56px;">
        <div class="section-eyebrow" style="justify-content:center;">Capacidades</div>
        <h2 class="section-heading" style="margin: 0 auto; max-width: 720px;">Seis lentes. <span class="blue">Uma imagem.</span></h2>
      </div>

      <div class="cap-grid">
        <div class="cap-card reveal reveal-delay-1" tabindex="0">
          <div class="cap-card-photo" style="background-image:url('/photos/card-adv-site-selection.jpg');"></div>
          <div class="cap-card-body">
            <div class="cap-num">01 — Site</div>
            <h3 class="cap-title">Seleção de site</h3>
            <p class="cap-desc">Cidades LatAm pontuadas por terreno, grid, água, fibra e incentivos fiscais.</p>
          </div>
        </div>
        <div class="cap-card reveal reveal-delay-2" tabindex="0">
          <div class="cap-card-photo" style="background-image:url('/photos/card-adv-power-grid.jpg');"></div>
          <div class="cap-card-body">
            <div class="cap-num">02 — Energia</div>
            <h3 class="cap-title">Energia &amp; grid</h3>
            <p class="cap-desc">Margin analysis, contingência N-1, panorama de headroom multi-país em toda a LatAm.</p>
          </div>
        </div>
        <div class="cap-card reveal reveal-delay-3" tabindex="0">
          <div class="cap-card-photo" style="background-image:url('/photos/card-dev-codeveloper.jpg');"></div>
          <div class="cap-card-body">
            <div class="cap-num">03 — Ativos</div>
            <h3 class="cap-title">Pipeline de ativos</h3>
            <p class="cap-desc">Pipeline curado de terras greenfield e ativos industriais brownfield — portfólios CMP e de terceiros.</p>
          </div>
        </div>
        <div class="cap-card reveal reveal-delay-1" tabindex="0">
          <div class="cap-card-photo" style="background-image:url('/photos/card-adv-regulatory.jpg');"></div>
          <div class="cap-card-body">
            <div class="cap-num">04 — Regulatório</div>
            <h3 class="cap-title">Regulatório &amp; tributário</h3>
            <p class="cap-desc">Permitting, incentivos fiscais e licenciamento telecom — em BR, CL, MX e mercados LatAm emergentes.</p>
          </div>
        </div>
        <div class="cap-card reveal reveal-delay-2" tabindex="0">
          <div class="cap-card-photo" style="background-image:url('/photos/card-adv-financial.jpg');"></div>
          <div class="cap-card-body">
            <div class="cap-num">05 — Advisory</div>
            <h3 class="cap-title">Business advisory</h3>
            <p class="cap-desc">Deal structuring, M&amp;A e project structuring — números que um comitê de crédito aprova.</p>
          </div>
        </div>
        <div class="cap-card reveal reveal-delay-3" tabindex="0">
          <div class="cap-card-photo" style="background-image:url('/photos/card-adv-market-intel.jpg');"></div>
          <div class="cap-card-body">
            <div class="cap-num">06 — Inteligência</div>
            <h3 class="cap-title">Inteligência de mercado</h3>
            <p class="cap-desc">Sinais de demanda, pipeline de oferta e mapeamento de concorrentes — fontes primárias.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec-navy sec-pad">
    <div class="wrap">
      <div class="reveal" style="text-align:center; margin-bottom: 24px;">
        <div class="section-eyebrow" style="justify-content:center;">Engajamento</div>
        <h2 class="section-heading" style="margin: 0 auto; max-width: 760px;">Quatro fases. <span class="blue">End-to-end ou à la carte.</span></h2>
        <p style="margin: 22px auto 0; max-width: 580px; font-size: 15px; line-height: 1.55; color: var(--cream-1);">Engaje a CMP no ciclo completo, ou nos chame para uma fase específica onde mais faz diferença.</p>
      </div>

      <div class="engagement-timeline">
        <div class="engagement-line" aria-hidden="true"></div>

        <div class="eng-step c1 reveal reveal-delay-1">
          <div class="eng-step-circle">01</div>
          <h4>Tese</h4>
          <p>Tese de investimento, sizing de mercado e framework de pontuação.</p>
          <div class="eng-step-output"><strong>Entrega</strong>Memo de tese + framework de scoring</div>
        </div>

        <div class="eng-step c2 reveal reveal-delay-2">
          <div class="eng-step-circle">02</div>
          <h4>Shortlist</h4>
          <p>Pesquisa primária em sites candidatos nos mercados-alvo.</p>
          <div class="eng-step-output"><strong>Entrega</strong>Shortlist rankeado de sites qualificados</div>
        </div>

        <div class="eng-step c3 reveal reveal-delay-3">
          <div class="eng-step-circle">03</div>
          <h4>Diligência</h4>
          <p>DD de engenharia, financeira e regulatória nos sites preferidos.</p>
          <div class="eng-step-output"><strong>Entrega</strong>Memo de investimento por site</div>
        </div>

        <div class="eng-step c4 reveal reveal-delay-3">
          <div class="eng-step-circle">04</div>
          <h4>Fechamento</h4>
          <p>Suporte ao term sheet, handoff EPC e narrativa para mercado de capitais.</p>
          <div class="eng-step-output"><strong>Entrega</strong>Term sheet assinado + plano RTB</div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec-cream sec-pad-sm on-cream">
    <div style="display:flex; align-items:center; justify-content:space-between; gap:48px; flex-wrap:wrap; padding: 0 clamp(28px, 4vw, 64px);">
      <div>
        <div class="section-eyebrow" style="margin-bottom:18px;">Prontos quando você estiver</div>
        <h2 class="section-heading">Traga uma tese. <span class="blue">Vamos pressioná-la.</span></h2>
      </div>
      <div style="display:flex; gap:14px; flex-wrap:wrap;">
        <a class="btn-primary" href="mailto:info@cloudmindspartners.com">Contratar consultoria
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg>
        </a>
        <a class="btn-outline" href="/pt/intelligence">Ler um memo</a>
      </div>
    </div>
  </section>

  <footer>
    <div class="foot-links">
      <div class="foot-brand-cell">
        <a class="brand" href="/pt/"><img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" /></a>
        <p>Inteligência de data centers para a América Latina.</p>
        <div class="foot-social" aria-label="Siga-nos">
          <a href="https://www.linkedin.com/company/cloud-minds-partners" aria-label="LinkedIn" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.97 0 1.77-.77 1.77-1.72V1.72C24 .77 23.2 0 22.23 0z"/></svg></a>
          <a href="https://wa.me/5511915788796" aria-label="WhatsApp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.4.5-.6.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3 4.8 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4 0-.1-.3-.2-.5-.3zM12 22a10 10 0 0 1-5-1.3L2 22l1.3-5A10 10 0 1 1 12 22zm0-18.2A8.2 8.2 0 0 0 4.6 16l-.2.5-.8 3 3-.8.5.2c1.2.7 2.6 1.1 4 1.1 4.5 0 8.2-3.7 8.2-8.2S16.5 3.8 12 3.8z"/></svg></a>
        </div>
      </div>
      <div><h4>Plataformas</h4><ul><li><a href="/pt/platforms">Site Screening Tool</a></li><li><a href="/pt/platforms">Grid Intelligence</a></li><li><a href="/pt/platforms">DC Insights</a></li><li><a href="/pt/platforms">DC Test Fit Pro</a></li><li><a href="/pt/platforms">DC Financial Model</a></li></ul></div>
      <div><h4>Inteligência</h4><ul><li><a href="/pt/intelligence">Memos Técnicos</a></li><li><a href="/pt/intelligence">Radar de Inovação</a></li><li><a href="/pt/intelligence">Vigilância Regulatória</a></li><li><a href="/pt/intelligence">Pulse Semanal</a></li></ul></div>
      <div><h4>Empresa</h4><ul><li><a href="/pt/advisory">Consultoria</a></li><li><a href="/pt/development">Desenvolvimento</a></li><li><a href="/pt/team">Equipe</a><a href="/pt/contact">Contato</a></li></ul></div>
      <div><h4>Contato</h4><ul><li><a href="mailto:info@cloudmindspartners.com">info@cloudmindspartners.com</a></li><li><a href="tel:+5511915788796">+55 11 91578-8796</a></li><li>São Paulo · BR</li><li>Santiago · CL</li><li>Cidade do México · MX</li></ul></div>
    </div>
    <LegalEntity />
    <div class="foot-bottom"><span>© 2026 Cloud Minds Partners</span><span>Todos os direitos reservados.</span></div>
  </footer>

  <script is:inline>
    const observer = new IntersectionObserver((entries) => { entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }); }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</Base>
