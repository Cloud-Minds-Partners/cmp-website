---
import Base from '../../layouts/Base.astro';
import SEO from '../../components/SEO.astro';
import LegalEntity from "../../components/LegalEntity.astro";
---

<Base lang="pt">
  <SEO
    slot="head"
    title="Desenvolvimento — Cloud Minds Partners"
    description="Da tese ao ready-to-build, diretamente. Construção, operação e energia orquestrados com parceiros operadores e provedores de energia."
    image="/og/development.png"
  />

  <style slot="head" is:global>
    .page-hero-bg { background-image: url("/photos/hero-development.jpg"); }

    .roles { padding: clamp(96px, 14vh, 160px) 0; background: var(--cream-bg); color: var(--navy-0); }
    .roles-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 64px;
    }
    .role-card {
      background: transparent;
      border: 1px solid rgba(5,14,29,0.12);
      border-radius: 20px;
      padding: 0;
      display: flex; flex-direction: column;
      text-align: center;
      overflow: hidden;
      min-height: 420px;
      transition: border-color var(--t-base), transform var(--t-base), box-shadow var(--t-base);
    }
    .role-card:hover {
      border-color: rgba(45,107,228,0.55);
      transform: translateY(-3px);
      box-shadow: 0 18px 44px rgba(45,107,228,0.12);
    }
    .role-photo {
      width: 100%; height: 200px;
      background-size: cover; background-position: center;
      filter: saturate(1.18) contrast(1.05);
      transition: transform var(--t-slow);
      border-radius: 19px 19px 0 0;
    }
    .role-card:hover .role-photo { transform: scale(1.04); }
    .role-body {
      padding: 32px 28px 36px;
      display: flex; flex-direction: column; gap: 12px;
      align-items: center; justify-content: center;
      flex: 1;
    }
    .role-num { font-family: var(--font-display); font-size: 13px; font-weight: 600; color: var(--blue-deep); letter-spacing: 0.04em; text-transform: uppercase; }
    .role-card h3 { font-family: var(--font-display); font-size: 28px; font-weight: 600; letter-spacing: -0.018em; margin: 0; color: var(--navy-0); }
    .role-card p { font-size: 16px; line-height: 1.55; color: #4D5F7A; margin: 0; max-width: 30ch; }

    .lifecycle { background: var(--navy-0); padding: clamp(96px, 14vh, 160px) 0; }
    .lifecycle-sub { text-align: center; margin-top: 18px; font-size: 14.5px; color: var(--cream-1); letter-spacing: 0.01em; }
    .lifecycle-sub strong { color: var(--cream-0); font-weight: 600; }
    .lifecycle-track {
      display: grid; grid-template-columns: repeat(5, 1fr);
      margin-top: 56px;
      border-top: 1px solid var(--line-0);
    }
    .lc-phase {
      padding: 40px 24px;
      border-right: 1px solid var(--line-0);
      text-align: center;
      display: flex; flex-direction: column; align-items: center; gap: 12px;
      transition: background var(--t-fast);
    }
    .lc-phase:last-child { border-right: 0; }
    a.lc-phase { color: inherit; text-decoration: none; }
    a.lc-phase:hover { background: rgba(74, 143, 231, 0.06); }
    a.lc-phase:hover h4 { color: var(--blue-bright); }

    .lc-phase.featured {
      position: relative;
      background: linear-gradient(180deg, rgba(245,158,11,0.10) 0%, rgba(245,158,11,0.02) 100%);
      border-right: 1px solid rgba(245,158,11,0.28);
      border-top: 0;
    }
    .lc-phase.featured::before {
      content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: #F59E0B;
      box-shadow: 0 0 14px rgba(245,158,11,0.65);
    }
    .lc-phase.featured .lc-num { color: #F59E0B; }
    .lc-phase.featured .lc-label strong { color: #F59E0B; font-weight: 700; font-size: 14px; letter-spacing: 0.01em; }
    .lc-phase.featured h4 { color: #fff; }
    .lc-phase.featured:hover { background: linear-gradient(180deg, rgba(245,158,11,0.16) 0%, rgba(245,158,11,0.04) 100%); }
    a.lc-phase.featured:hover h4 { color: #F59E0B; }
    .lc-num { font-family: var(--font-display); font-size: 56px; font-weight: 600; color: var(--blue-bright); line-height: 1; letter-spacing: var(--track-tight); }
    .lc-label { font-family: var(--font-body); font-size: 12.5px; color: var(--cream-3); }
    .lc-phase h4 { font-family: var(--font-display); font-size: 19px; font-weight: 600; margin: 0; color: var(--cream-0); letter-spacing: -0.012em; }
    .lc-phase p { font-size: 14px; line-height: 1.55; color: var(--cream-1); margin: 0; max-width: 28ch; }
    .lc-role {
      margin-top: 8px;
      font-family: var(--font-body); font-size: 10.5px; font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase;
      padding: 4px 10px; border-radius: 999px;
      display: inline-flex; align-items: center; gap: 6px;
    }
    .lc-role::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
    .lc-role.direct { background: rgba(74, 222, 128, 0.10); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.30); }
    .lc-role.partners { background: rgba(13, 148, 136, 0.15); color: #14b8a6; border: 1px solid rgba(13, 148, 136, 0.40); }
    .lc-role.tool { background: rgba(245, 158, 11, 0.14); color: #F59E0B; border: 1px solid rgba(245, 158, 11, 0.50); }

    @media (max-width: 880px) {
      .roles-grid, .lifecycle-track { grid-template-columns: 1fr; }
      .lc-phase { border-right: 0; border-bottom: 1px solid var(--line-0); }
    }
  </style>

  <nav class="nav">
    <div class="nav-inner">
      <a class="brand" href="/pt/"><img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" /><span class="brand-tag">A firma de inteligência DC da América Latina.</span></a>
      <div class="nav-links"><a href="/pt/advisory">Consultoria</a><a href="/pt/development" class="active">Desenvolvimento</a><a href="/pt/intelligence">Inteligência</a><a href="/pt/platforms">Plataformas</a><a href="/pt/team">Equipe</a><a href="/pt/contact">Contato</a></div>
      <div class="nav-right"><div class="nav-lang">
        <a href="/development">EN</a><span class="sep">·</span><a href="/pt/development" class="active">PT</a><span class="sep">·</span><a href="/es/development">ES</a>
      </div>
      <a href="mailto:info@cloudmindspartners.com" class="nav-cta">Fale conosco <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg></a></div>
    </div>
  </nav>

  <header class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="page-hero-overlay" aria-hidden="true"></div>
    <div class="wrap">
      <div class="page-hero-content">
        <div class="page-eyebrow live">Desenvolvimento</div>
        <h1>Da tese ao <em>ready-to-build.</em></h1>
        <p>CMP entrega todo o desenvolvimento diretamente até o RTB. Construção, operação e suprimento de energia são orquestrados com parceiros operadores e provedores de energia — um time accountable só.</p>
      </div>
    </div>
  </header>

  <section class="roles on-cream">
    <div class="wrap">
      <div class="reveal" style="text-align:center;">
        <div class="section-eyebrow" style="justify-content:center;">Papéis</div>
        <h2 class="section-heading" style="margin: 0 auto; max-width: 680px;">Três formas de estar na <span class="blue">cap table.</span></h2>
      </div>
      <div class="roles-grid">
        <div class="role-card reveal reveal-delay-1">
          <div class="role-photo" style="background-image:url('/photos/card-dev-codeveloper.jpg');"></div>
          <div class="role-body">
            <div class="role-num">01 — Equity stake</div>
            <h3>Co-desenvolvedor</h3>
            <p>Entregamos o desenvolvimento da tese ao RTB em troca de equity stake no fechamento financeiro.</p>
          </div>
        </div>
        <div class="role-card reveal reveal-delay-2">
          <div class="role-photo" style="background-image:url('/photos/card-dev-tech-advisor.jpg');"></div>
          <div class="role-body">
            <div class="role-num">02 — Fee-based</div>
            <h3>Consultor técnico</h3>
            <p>Due diligence e estruturação para investidores institucionais e operadores.</p>
          </div>
        </div>
        <div class="role-card reveal reveal-delay-3">
          <div class="role-photo" style="background-image:url('/photos/card-dev-financial-partner.jpg');"></div>
          <div class="role-body">
            <div class="role-num">03 — Orquestração de capital</div>
            <h3>Arquiteto da operação</h3>
            <p>Trazemos investidores estratégicos. Estruturamos M&amp;A, JVs e a cap table completa — ao lado de parceiros operadores e de energia.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="lifecycle">
    <div class="wrap">
      <div class="reveal" style="text-align:center;">
        <div class="section-eyebrow" style="justify-content:center;">Ciclo</div>
        <h2 class="section-heading" style="margin: 0 auto; max-width: 720px;">Da tese ao <span class="blue">comissionamento.</span></h2>
        <p class="lifecycle-sub"><strong>00–02 CMP direto.</strong> 03–04 com parceiros operadores e de energia.</p>
      </div>
    </div>
    <div class="lifecycle-track">
      <a class="lc-phase featured reveal" href="/pt/platforms#site-screening-tool">
        <div class="lc-num">00</div>
        <div class="lc-label">Entrega em <strong>72h</strong></div>
        <h4>Site screening</h4>
        <p>Pontue 76+ cidades LatAm em 8 critérios com nosso Site Screening Tool.</p>
        <div class="lc-role tool">Usar SST →</div>
      </a>
      <div class="lc-phase reveal reveal-delay-1">
        <div class="lc-num">01</div>
        <div class="lc-label">0–6 meses</div>
        <h4>Pré-site</h4>
        <p>Qualificação, modelagem de offtake, term sheet em 90 dias.</p>
        <div class="lc-role direct">CMP direto</div>
      </div>
      <div class="lc-phase reveal reveal-delay-2">
        <div class="lc-num">02</div>
        <div class="lc-label">6–18 meses</div>
        <h4>Design &amp; licenças → RTB</h4>
        <p>DD técnica, interconexão, protocolos ambientais — até ready-to-build.</p>
        <div class="lc-role direct">CMP direto</div>
      </div>
      <div class="lc-phase reveal reveal-delay-3">
        <div class="lc-num">03</div>
        <div class="lc-label">18–36 meses</div>
        <h4>Construção</h4>
        <p>EPC e obra executados pelo parceiro.</p>
        <div class="lc-role partners">Com parceiros</div>
      </div>
      <div class="lc-phase reveal reveal-delay-3">
        <div class="lc-num">04</div>
        <div class="lc-label">Contínuo</div>
        <h4>Operação &amp; energia</h4>
        <p>Parceiro operador toca o ativo. Parceiro de energia fornece o PPA.</p>
        <div class="lc-role partners">Com parceiros</div>
      </div>
    </div>
  </section>

  <footer>
    <div class="foot-links">
      <div class="foot-brand-cell">
        <a class="brand" href="/pt/"><img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" /></a>
        <p>Inteligência de data centers para a América Latina.</p>
        <div class="foot-social" aria-label="Siga-nos">
          <a href="https://www.linkedin.com/company/cloud-minds-partners" aria-label="LinkedIn" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.97 0 1.77-.77 1.77-1.72V1.72C24 .77 23.2 0 22.23 0z"/></svg></a>
          <a href="https://wa.me/5511915788796" aria-label="WhatsApp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.4.5-.6.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3 4.8 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4 0-.1-.3-.2-.5-.3zM12 22a10 10 0 0 1-5-1.3L2 22l1.3-5A10 10 0 1 1 12 22zm0-18.2A8.2 8.2 0 0 0 4.6 16l-.2.5-.8 3 3-.8.5.2c1.2.7 2.6 1.1 4 1.1 4.5 0 8.2-3.7 8.2-8.2S16.5 3.8 12 3.8z"/></svg></a>
        </div>
      </div>
      <div><h4>Plataformas</h4><ul><li><a href="/pt/platforms">Site Screening Tool</a></li><li><a href="/pt/platforms">Grid Intelligence</a></li><li><a href="/pt/platforms">DC Insights</a></li><li><a href="/pt/platforms">DC Test Fit Pro</a></li><li><a href="/pt/platforms">DC Financial Model</a></li></ul></div>
      <div><h4>Inteligência</h4><ul><li><a href="/pt/intelligence">Memos Técnicos</a></li><li><a href="/pt/intelligence">Radar de Inovação</a></li><li><a href="/pt/intelligence">Vigilância Regulatória</a></li><li><a href="/pt/intelligence">Pulse Semanal</a></li></ul></div>
      <div><h4>Empresa</h4><ul><li><a href="/pt/advisory">Consultoria</a></li><li><a href="/pt/development">Desenvolvimento</a></li><li><a href="/pt/team">Equipe</a><a href="/pt/contact">Contato</a></li></ul></div>
      <div><h4>Contato</h4><ul><li><a href="mailto:info@cloudmindspartners.com">info@cloudmindspartners.com</a></li><li><a href="tel:+5511915788796">+55 11 91578-8796</a></li><li>São Paulo · BR</li><li>Santiago · CL</li><li>Cidade do México · MX</li></ul></div>
    </div>
    <LegalEntity />
    <div class="foot-bottom"><span>© 2026 Cloud Minds Partners</span><span>Todos os direitos reservados.</span></div>
  </footer>

  <script is:inline>
    const observer = new IntersectionObserver((entries) => { entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }); }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</Base>
