---
import Base from '../layouts/Base.astro';
import SEO from '../components/SEO.astro';
import { social, whatsappLink } from '../config/social';

const waUrl = social.whatsappNumber ? whatsappLink() : null;
import LegalEntity from "../components/LegalEntity.astro";
---

<Base lang="en">
  <SEO
    slot="head"
    title="Contact — Cloud Minds Partners"
    description="Get in touch with Cloud Minds Partners. Email, WhatsApp, or LinkedIn — we respond within 24 hours."
    lang="en"
  />

  <style slot="head" is:global>
    .page-hero-bg { background-image: url("/photos/hero-contact.jpg"); }

    .contact-options {
      background: var(--cream-bg);
      color: var(--navy-0);
      padding: clamp(80px, 10vh, 128px) 0;
    }
    .contact-options .section-inner {
      max-width: var(--max-w); margin: 0 auto;
      padding: 0 clamp(28px, 4vw, 64px);
    }
    .contact-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 48px;
    }
    .contact-option { display: flex; flex-direction: column; gap: 14px; }
    .contact-icon {
      width: 64px; height: 64px;
      display: flex; align-items: center; justify-content: center;
      border-radius: 50%;
      margin-bottom: 6px;
      transition: transform var(--t-fast), box-shadow var(--t-fast);
    }
    .contact-option:hover .contact-icon { transform: translateY(-2px); }
    .contact-icon.email {
      background: rgba(74, 143, 231, 0.10);
      color: var(--blue);
      border: 1px solid rgba(74, 143, 231, 0.28);
      box-shadow: 0 8px 20px rgba(74, 143, 231, 0.10);
    }
    .contact-icon.whatsapp {
      background: rgba(37, 211, 102, 0.12);
      color: #128C7E;
      border: 1px solid rgba(37, 211, 102, 0.35);
      box-shadow: 0 8px 20px rgba(37, 211, 102, 0.14);
    }
    .contact-icon.linkedin {
      background: rgba(10, 102, 194, 0.10);
      color: #0A66C2;
      border: 1px solid rgba(10, 102, 194, 0.28);
      box-shadow: 0 8px 20px rgba(10, 102, 194, 0.10);
    }
    .contact-icon svg { width: 28px; height: 28px; }
    .contact-option h3 {
      font-family: var(--font-display); font-size: 20px; font-weight: 600;
      color: var(--navy-0); margin: 0;
    }
    .contact-option p {
      font-size: 15px; line-height: 1.6; color: #4d5f7a;
      margin: 0; max-width: 280px;
    }
    .contact-link {
      display: inline-flex; align-items: center;
      font-family: var(--font-display);
      font-size: 15px; font-weight: 600;
      color: var(--blue); text-decoration: underline;
      text-underline-offset: 3px;
      transition: opacity 0.15s; margin-top: 4px;
    }
    .contact-link:hover { opacity: 0.75; }
    .contact-link-placeholder {
      display: inline-flex; align-items: center;
      font-family: var(--font-display); font-size: 15px;
      color: #677793; margin-top: 4px;
    }

    .inquiry-section {
      background: var(--navy-0); color: var(--cream-0);
      padding: clamp(80px, 10vh, 128px) 0 clamp(96px, 14vh, 160px);
    }
    .inquiry-section .section-inner {
      max-width: 760px; margin: 0 auto;
      padding: 0 clamp(28px, 4vw, 64px);
    }
    .inquiry-header { margin-bottom: 48px; }
    .inquiry-header h2 {
      font-family: var(--font-display);
      font-size: clamp(28px, 3.5vw, 42px);
      font-weight: 600; color: var(--cream-0);
      margin: 0 0 12px; line-height: 1.1;
    }
    .inquiry-note { font-size: 15px; color: var(--cream-2); margin: 0; }

    .inquiry-form { display: flex; flex-direction: column; gap: 24px; }
    .form-row.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .form-field { display: flex; flex-direction: column; gap: 8px; }
    .form-field label {
      font-family: var(--font-display); font-size: 12px;
      font-weight: 600; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--cream-2);
    }
    .form-field input, .form-field textarea {
      width: 100%;
      background: rgba(250, 251, 253, 0.04);
      border: 1px solid rgba(250, 251, 253, 0.12);
      border-radius: 8px; padding: 12px 16px;
      font-family: var(--font-display); font-size: 15px;
      color: var(--cream-0);
      transition: border-color 0.15s; box-sizing: border-box;
    }
    .form-field input::placeholder, .form-field textarea::placeholder { color: rgba(250, 251, 253, 0.25); }
    .form-field input:focus, .form-field textarea:focus {
      outline: none;
      border-color: rgba(74, 143, 231, 0.55);
      background: rgba(250, 251, 253, 0.06);
    }
    .form-field textarea { resize: vertical; min-height: 120px; }
    .btn-submit {
      display: inline-flex; align-items: center; justify-content: center;
      align-self: flex-start;
      padding: 14px 32px; border-radius: 999px;
      background: var(--blue); color: var(--cream-0);
      font-family: var(--font-display);
      font-size: 15px; font-weight: 600;
      border: none; cursor: pointer; text-decoration: none;
      transition: opacity 0.2s, transform 0.2s;
    }
    .btn-submit:hover { opacity: 0.85; transform: translateY(-1px); }

    @media (max-width: 880px) {
      .contact-grid { grid-template-columns: 1fr; gap: 40px; }
      .form-row.two-col { grid-template-columns: 1fr; }
    }
  </style>

  <nav class="nav">
    <div class="nav-inner">
      <a class="brand" href="/"><img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" /><span class="brand-tag">The LatAm DC intelligence firm.</span></a>
      <div class="nav-links"><a href="/advisory">Advisory</a><a href="/development">Development</a><a href="/intelligence">Intelligence</a><a href="/platforms">Platforms</a><a href="/team">Team</a><a href="/contact">Contact</a></div>
      <div class="nav-right"><div class="nav-lang">
        <a href="/contact" class="active">EN</a><span class="sep">·</span><a href="/pt/contact">PT</a><span class="sep">·</span><a href="/es/contact">ES</a>
      </div>
      <a href="mailto:info@cloudmindspartners.com" class="nav-cta">Talk to us <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg></a></div>
    </div>
  </nav>

  <header class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="page-hero-overlay" aria-hidden="true"></div>
    <div class="wrap">
      <div class="page-hero-content">
        <div class="page-eyebrow live">Contact</div>
        <h1>Let's <em>talk.</em></h1>
        <p>Bring the question — we work the problem.</p>
      </div>
    </div>
  </header>

  <section class="contact-options">
    <div class="section-inner">
      <div class="contact-grid">
        <div class="contact-option">
          <div class="contact-icon email" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          </div>
          <h3>Email</h3>
          <p>Primary channel for advisory inquiries and project scoping.</p>
          <a href={`mailto:${social.emailGeneral}`} class="contact-link">{social.emailGeneral}</a>
        </div>

        <div class="contact-option">
          <div class="contact-icon whatsapp" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          </div>
          <h3>WhatsApp</h3>
          <p>Quick questions and scheduling — direct line to the team.</p>
          {waUrl ? (
            <a href={waUrl} class="contact-link" target="_blank" rel="noopener noreferrer">Open WhatsApp</a>
          ) : (
            <span class="contact-link-placeholder">Available on request</span>
          )}
        </div>

        <div class="contact-option">
          <div class="contact-icon linkedin" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </div>
          <h3>LinkedIn</h3>
          <p>Follow our research and market intelligence updates.</p>
          <a href={social.linkedin} class="contact-link" target="_blank" rel="noopener noreferrer">Cloud Minds Partners</a>
        </div>
      </div>
    </div>
  </section>

  <section class="inquiry-section">
    <div class="section-inner">
      <div class="inquiry-header">
        <p class="section-eyebrow">Inquire</p>
        <h2>Send a project brief</h2>
        <p class="inquiry-note">We respond to every inquiry within 24 hours on business days.</p>
      </div>
      <form
        class="inquiry-form"
        action={`mailto:${social.emailGeneral}`}
        method="get"
        enctype="text/plain"
      >
        <div class="form-row two-col">
          <div class="form-field">
            <label for="contact-name">Name</label>
            <input id="contact-name" name="name" type="text" placeholder="Your name" required autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="contact-company">Company</label>
            <input id="contact-company" name="company" type="text" placeholder="Company or fund" autocomplete="organization" />
          </div>
        </div>
        <div class="form-field">
          <label for="contact-email">Email</label>
          <input id="contact-email" name="email" type="email" placeholder="you@company.com" required autocomplete="email" />
        </div>
        <div class="form-field">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="message" rows="5" placeholder="Tell us about your project or question — market, stage, and what you need." required></textarea>
        </div>
        <button type="submit" class="btn-submit">Get in touch</button>
      </form>
    </div>
  </section>

  <footer>
    <div class="foot-links">
      <div class="foot-brand-cell">
        <a class="brand" href="/"><img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" /></a>
        <p>Data center intelligence for Latin America.</p>
        <div class="foot-social" aria-label="Follow us">
          <a href="https://www.linkedin.com/company/cloud-minds-partners" aria-label="LinkedIn" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.97 0 1.77-.77 1.77-1.72V1.72C24 .77 23.2 0 22.23 0z"/></svg></a>
          <a href="https://wa.me/5511915788796" aria-label="WhatsApp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.4.5-.6.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3 4.8 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4 0-.1-.3-.2-.5-.3zM12 22a10 10 0 0 1-5-1.3L2 22l1.3-5A10 10 0 1 1 12 22zm0-18.2A8.2 8.2 0 0 0 4.6 16l-.2.5-.8 3 3-.8.5.2c1.2.7 2.6 1.1 4 1.1 4.5 0 8.2-3.7 8.2-8.2S16.5 3.8 12 3.8z"/></svg></a>
        </div>
      </div>
      <div><h4>Platforms</h4><ul><li><a href="/platforms">Site Screening Tool</a></li><li><a href="/platforms">Grid Intelligence</a></li><li><a href="/platforms">DC Insights</a></li><li><a href="/platforms">DC Test Fit Pro</a></li><li><a href="/platforms">DC Financial Model</a></li></ul></div>
      <div><h4>Intelligence</h4><ul><li><a href="/intelligence">Technical Memos</a></li><li><a href="/intelligence">Innovation Radar</a></li><li><a href="/intelligence">Regulatory Watch</a></li><li><a href="/intelligence">Weekly Pulse</a></li></ul></div>
      <div><h4>Company</h4><ul><li><a href="/advisory">Advisory</a></li><li><a href="/development">Development</a></li><li><a href="/team">Team</a><a href="/contact">Contact</a></li></ul></div>
      <div><h4>Contact</h4><ul><li><a href="mailto:info@cloudmindspartners.com">info@cloudmindspartners.com</a></li><li><a href="tel:+5511915788796">+55 11 91578-8796</a></li><li>São Paulo · BR</li><li>Santiago · CL</li><li>Mexico City · MX</li></ul></div>
    </div>
    <LegalEntity />
    <div class="foot-bottom"><span>© 2026 Cloud Minds Partners</span><span>All rights reserved.</span></div>
  </footer>

  <script is:inline>
    const observer = new IntersectionObserver((entries) => { entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }); }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</Base>
