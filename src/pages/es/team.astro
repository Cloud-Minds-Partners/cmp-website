---
import Base from '../../layouts/Base.astro';
import SEO from '../../components/SEO.astro';
import LegalEntity from "../../components/LegalEntity.astro";
---

<Base lang="es">
  <SEO
    slot="head"
    title="Equipo — Cloud Minds Partners"
    description="Una sociedad pequeña. Un banco más amplio. Dos socios en São Paulo. Un banco de asesores en Brasil."
    image="/og/team.png"
  />

  <style slot="head" is:global>
    .page-hero-bg { background-image: url("/photos/hero-team.jpg"); }

    .leadership { padding: clamp(80px, 12vh, 144px) 0; background: var(--cream-bg); color: var(--navy-0); }
    .partner-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin: 56px 0 0;
    }
    .partner-card { border-radius: 24px;
      background: transparent;
      border: 1px solid rgba(5,14,29,0.12);
      padding: 56px clamp(32px, 4vw, 64px);
      display: flex; flex-direction: column; gap: 22px;
      align-items: center; text-align: center;
      transition: border-color var(--t-base), transform var(--t-base), box-shadow var(--t-base);
    }
    .partner-card:hover {
      border-color: rgba(45,107,228,0.55);
      transform: translateY(-3px);
      box-shadow: 0 18px 44px rgba(45,107,228,0.12);
    }
    .partner-avatar {
      width: 200px; height: 200px; border-radius: 50%;
      background-size: cover; background-position: center top;
      border: 3px solid rgba(255,255,255,0.7);
      box-shadow: 0 8px 24px rgba(5,14,29,0.10);
    }
    .partner-avatar.gustavo { background-size: cover; background-position: center 18%; }
    .partner-name { font-family: var(--font-display); font-size: 34px; font-weight: 600; letter-spacing: -0.022em; color: var(--navy-0); margin: 0; line-height: 1.1; }
    .partner-role { font-family: var(--font-display); font-size: 15px; color: var(--blue-deep); font-weight: 600; letter-spacing: -0.005em; }
    .partner-bio { font-size: 17px; line-height: 1.55; color: #3D4E68; margin: 0; max-width: 38ch; flex: 1; display: flex; align-items: center; }
    .partner-meta { font-family: var(--font-body); font-size: 14px; color: #677793; padding-top: 14px; margin-top: auto; border-top: 1px solid rgba(5,14,29,0.08); width: 80%; }

    .bench { background: var(--navy-0); padding: clamp(96px, 14vh, 160px) 0; }
    .bench-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 56px;
    }
    .bench-card { border-radius: 22px;
      padding: 44px clamp(24px, 3vw, 40px);
      background: var(--navy-1);
      border: 1px solid var(--line-1);
      display: flex; flex-direction: column; gap: 16px;
      align-items: center; text-align: center;
      transition: background var(--t-base), border-color var(--t-base), transform var(--t-base);
    }
    .bench-card:hover { background: var(--navy-2); border-color: rgba(74,143,231,0.5); transform: translateY(-2px); }
    .bench-photo { width: 128px; height: 128px; border-radius: 50%; background-size: cover; background-position: center 30%; border: 2px solid rgba(255,255,255,0.12); box-shadow: 0 8px 24px rgba(0,0,0,0.30); }
    .bench-photo.joao { background-position: center 50%; background-size: 180%; }
    .bench-photo.rodrigo { background-position: center 22%; background-size: 120%; }
    .bench-photo.sergio { background-position: 40% 55%; background-size: 125%; }
    .bench-domain { font-family: var(--font-display); font-size: 13px; color: var(--blue-bright); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
    .bench-name { font-family: var(--font-display); font-size: 24px; font-weight: 600; color: var(--cream-0); letter-spacing: -0.014em; margin: 0; line-height: 1.15; }
    .bench-credit { font-size: 15px; color: var(--cream-1); margin: 0; line-height: 1.55; max-width: 26ch; }
    .bench-tag { font-family: var(--font-body); font-size: 13px; color: var(--cream-3); padding-top: 12px; border-top: 1px solid var(--line-0); width: 80%; }

    @media (max-width: 880px) {
      .partner-grid, .bench-grid { grid-template-columns: 1fr; }
    }
  </style>

  <nav class="nav">
    <div class="nav-inner">
      <a class="brand" href="/es/"><img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" /><span class="brand-tag">La firma de inteligencia DC de América Latina.</span></a>
      <div class="nav-links"><a href="/es/advisory">Asesoría</a><a href="/es/development">Desarrollo</a><a href="/es/intelligence">Inteligencia</a><a href="/es/platforms">Plataformas</a><a href="/es/team" class="active">Equipo</a><a href="/es/contact">Contacto</a></div>
      <div class="nav-right"><div class="nav-lang">
        <a href="/team">EN</a><span class="sep">·</span><a href="/pt/team">PT</a><span class="sep">·</span><a href="/es/team" class="active">ES</a>
      </div>
      <a href="mailto:info@cloudmindspartners.com" class="nav-cta">Habla con nosotros <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg></a></div>
    </div>
  </nav>

  <header class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="page-hero-overlay" aria-hidden="true"></div>
    <div class="wrap">
      <div class="page-hero-content">
        <div class="page-eyebrow live">Equipo</div>
        <h1>Una sociedad pequeña. <em>Un&nbsp;banco&nbsp;más&nbsp;amplio.</em></h1>
        <p>Dos socios en São Paulo. Un banco de asesores en Brasil.</p>
      </div>
    </div>
  </header>

  <section class="leadership on-cream">
    <div class="wrap">
      <div class="reveal" style="text-align:center;">
        <div class="section-eyebrow" style="justify-content:center;">Socios</div>
        <h2 class="section-heading" style="margin: 0 auto; max-width: 720px;">Conocimiento profundo de infraestructura LatAm. <span class="blue">Experiencia sénior.</span></h2>
      </div>
      <div class="partner-grid">
        <article class="partner-card reveal reveal-delay-1">
          <div class="partner-avatar" style="background-image: url('/photos/people/edgard-abreu.jpg');"></div>
          <h3 class="partner-name">Edgard Abreu</h3>
          <div class="partner-role">Founder &amp; CEO</div>
          <p class="partner-bio">20+ años en infraestructura. Lideró adquisiciones de US$ 500M+ y contratos de power-of-connection de 1 GW en LatAm.</p>
          <div class="partner-meta">Real Estate · Capital · M&amp;A</div>
        </article>
        <article class="partner-card reveal reveal-delay-2">
          <div class="partner-avatar gustavo" style="background-image: url('/photos/people/gustavo-kummer.jpg');"></div>
          <h3 class="partner-name">Gustavo Kummer</h3>
          <div class="partner-role">Head of Design &amp; PM</div>
          <p class="partner-bio">Arquitecto y urbanista con 20+ años. Certificaciones PMP y CP3P. Regulación urbana y viabilidad.</p>
          <div class="partner-meta">Diseño · Urbanismo · PM</div>
        </article>
      </div>
    </div>
  </section>

  <section class="bench">
    <div class="wrap">
      <div class="reveal" style="text-align:center;">
        <div class="section-eyebrow" style="justify-content:center;">Banco</div>
        <h2 class="section-heading" style="margin: 0 auto; max-width: 720px;">Asesores senior. <span class="blue">A una llamada.</span></h2>
      </div>
      <div class="bench-grid">
        <div class="bench-card reveal reveal-delay-1">
          <div class="bench-photo joao" style="background-image: url('/photos/people/joao-carlos-aires.jpg');"></div>
          <div class="bench-domain">Energía · Interconexión</div>
          <h4 class="bench-name">João Carlos Aires</h4>
          <p class="bench-credit">PhD (PUC-Rio), 30+ años. Ex-Gerente de Planeamiento de LIGHT.</p>
          <span class="bench-tag">Rio de Janeiro</span>
        </div>
        <div class="bench-card reveal reveal-delay-2">
          <div class="bench-photo rodrigo" style="background-image: url('/photos/people/rodrigo-pelosini.jpg');"></div>
          <div class="bench-domain">Telecom · Conectividad</div>
          <h4 class="bench-name">Rodrigo Pelosini</h4>
          <p class="bench-credit">Ex-Head of Engineering UFINET Brasil. FTTH, DWDM, ANATEL.</p>
          <span class="bench-tag">São Paulo</span>
        </div>
        <div class="bench-card reveal reveal-delay-3">
          <div class="bench-photo sergio" style="background-image: url('/photos/people/sergio-pacheco.jpg');"></div>
          <div class="bench-domain">Regulatorio · Permisos</div>
          <h4 class="bench-name">Sérgio Pacheco</h4>
          <p class="bench-credit">30+ años en viabilidad y aprobaciones — federal, estatal, municipal.</p>
          <span class="bench-tag">São Paulo</span>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <div class="foot-links">
      <div class="foot-brand-cell">
        <a class="brand" href="/es/"><img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" /></a>
        <p>Inteligencia de data centers para América Latina.</p>
        <div class="foot-social" aria-label="Síguenos">
          <a href="https://www.linkedin.com/company/cloud-minds-partners" aria-label="LinkedIn" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.97 0 1.77-.77 1.77-1.72V1.72C24 .77 23.2 0 22.23 0z"/></svg></a>
          <a href="https://wa.me/5511915788796" aria-label="WhatsApp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.4.5-.6.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3 4.8 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4 0-.1-.3-.2-.5-.3zM12 22a10 10 0 0 1-5-1.3L2 22l1.3-5A10 10 0 1 1 12 22zm0-18.2A8.2 8.2 0 0 0 4.6 16l-.2.5-.8 3 3-.8.5.2c1.2.7 2.6 1.1 4 1.1 4.5 0 8.2-3.7 8.2-8.2S16.5 3.8 12 3.8z"/></svg></a>
        </div>
      </div>
      <div><h4>Plataformas</h4><ul><li><a href="/es/platforms">Site Screening Tool</a></li><li><a href="/es/platforms">Grid Intelligence</a></li><li><a href="/es/platforms">DC Insights</a></li><li><a href="/es/platforms">DC Test Fit Pro</a></li><li><a href="/es/platforms">DC Financial Model</a></li></ul></div>
      <div><h4>Inteligencia</h4><ul><li><a href="/es/intelligence">Memos Técnicos</a></li><li><a href="/es/intelligence">Radar de Innovación</a></li><li><a href="/es/intelligence">Vigilancia Regulatoria</a></li><li><a href="/es/intelligence">Pulse Semanal</a></li></ul></div>
      <div><h4>Empresa</h4><ul><li><a href="/es/advisory">Asesoría</a></li><li><a href="/es/development">Desarrollo</a></li><li><a href="/es/team">Equipo</a><a href="/es/contact">Contacto</a></li></ul></div>
      <div><h4>Contacto</h4><ul><li><a href="mailto:info@cloudmindspartners.com">info@cloudmindspartners.com</a></li><li><a href="tel:+5511915788796">+55 11 91578-8796</a></li><li>São Paulo · BR</li><li>Santiago · CL</li><li>Ciudad de México · MX</li></ul></div>
    </div>
    <LegalEntity />
    <div class="foot-bottom"><span>© 2026 Cloud Minds Partners</span><span>Todos los derechos reservados.</span></div>
  </footer>

  <script is:inline>
    const observer = new IntersectionObserver((entries) => { entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }); }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</Base>
