---
import Base from '../../layouts/Base.astro';
import SEO from '../../components/SEO.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { livePlatforms, inDevelopmentPlatforms } from '../../data/platforms';

const live = livePlatforms();
const inDev = inDevelopmentPlatforms();

let stripeIndex = 0;
const stripeBg = (i: number) => (i % 2 === 0 ? 'navy' : 'cream');
---

<Base lang="es">
  <SEO
    slot="head"
    title="Plataformas — Cloud Minds Partners"
    description="Herramientas que construimos. En producción y en desarrollo. Aplicadas a engagements en vivo en LatAm."
    image="/og/platforms.png"
  />

  <style slot="head" is:global>
    .page-hero-bg { background-image: url("/photos/hero-platforms.jpg"); }

    .products { padding: 0; }
    .product-section-header {
      background: var(--navy-0);
      padding: clamp(48px, 6vw, 80px) clamp(24px, 4vw, 64px);
      border-top: 1px solid rgba(255,255,255,0.06);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .product-section-header-inner {
      max-width: 1280px; margin: 0 auto;
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 24px; flex-wrap: wrap;
    }
    .product-section-eyebrow {
      font-family: var(--font-body); font-size: 12px;
      font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--blue-bright);
    }
    .product-section-title {
      font-family: var(--font-display);
      font-size: clamp(24px, 2.6vw, 32px);
      font-weight: 600; line-height: 1.15;
      color: var(--cream-0); margin: 6px 0 0 0;
    }
    .product-section-note {
      font-family: var(--font-body); font-size: 14px;
      color: var(--cream-1); max-width: 42ch;
      margin: 0;
    }

    .product { display: grid; grid-template-columns: 1fr 1fr; align-items: stretch; width: 100%; }
    .product-info {
      padding: clamp(56px, 8vh, 96px) clamp(48px, 6vw, 96px);
      display: flex; flex-direction: column; gap: 18px;
      align-items: center; justify-content: center; text-align: center;
    }
    .product-meta-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .product-info-num { font-family: var(--font-body); font-size: 12.5px; font-weight: 600; color: var(--blue-bright); }
    .product-info h3 {
      font-family: var(--font-display); font-size: clamp(28px, 3.2vw, 40px);
      line-height: 1.1; letter-spacing: var(--track-display);
      font-weight: 600; margin: 0; color: var(--cream-0); max-width: 16ch;
    }
    .product-info > p { font-size: 15.5px; line-height: 1.55; color: var(--cream-1); margin: 0; max-width: 38ch; }
    .product-subtag { font-size: 13.5px; line-height: 1.5; color: var(--cream-2); font-style: italic; margin: 4px 0 0; max-width: 38ch; }
    .product-info.on-cream .product-subtag { color: #6B7B92; }
    .product--soon .product-visual-bg { filter: saturate(0.5) brightness(0.85); }
    .product--soon .product-info { background-image: linear-gradient(180deg, rgba(148,163,184,0.04) 0%, transparent 100%); }
    .product-cta {
      margin-top: 8px; display: inline-flex; align-items: center; gap: 10px;
      font-size: 14px; font-weight: 600; color: var(--blue-bright);
      padding-bottom: 4px; border-bottom: 1px solid var(--blue-bright);
      transition: gap var(--t-fast);
    }
    .product-cta:hover { gap: 16px; color: var(--cream-0); }

    .product-info.on-navy { background: var(--navy-0); }
    .product-info.on-cream { background: var(--cream-bg); color: var(--navy-0); }
    .product-info.on-cream h3 { color: var(--navy-0); }
    .product-info.on-cream > p { color: #4D5F7A; }
    .product-info.on-cream .product-info-num { color: var(--blue-deep); }
    .product-info.on-cream .product-cta { color: var(--blue); border-color: var(--blue); }
    .product-info.on-cream .product-cta:hover { color: var(--navy-0); }

    .product.reverse .product-info { order: 2; }
    .product.reverse .product-visual { order: 1; }

    .product-visual { position: relative; min-height: 480px; overflow: hidden; }
    .product-visual-bg {
      position: absolute; inset: 0;
      background-size: cover; background-position: center;
      animation: prodKen 22s ease-in-out infinite alternate;
      filter: saturate(1.15) contrast(1.05);
    }
    @keyframes prodKen { 0% { transform: scale(1); } 100% { transform: scale(1.07); } }

    @media (max-width: 880px) {
      .product { grid-template-columns: 1fr; }
      .product-visual { min-height: 280px; }
      .product.reverse .product-info { order: 1; }
      .product.reverse .product-visual { order: 2; }
      .product-section-header-inner { flex-direction: column; align-items: flex-start; }
    }
  </style>

  <nav class="nav">
    <div class="nav-inner">
      <a class="brand" href="/es/"><img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" /><span class="brand-tag">La firma de inteligencia DC de América Latina.</span></a>
      <div class="nav-links"><a href="/es/advisory">Asesoría</a><a href="/es/development">Desarrollo</a><a href="/es/intelligence">Inteligencia</a><a href="/es/platforms" class="active">Plataformas</a><a href="/es/team">Equipo</a><a href="/es/contact">Contacto</a></div>
      <div class="nav-right"><div class="nav-lang">
        <a href="/platforms">EN</a><span class="sep">·</span><a href="/pt/platforms">PT</a><span class="sep">·</span><a href="/es/platforms" class="active">ES</a>
      </div>
      <a href="mailto:info@cloudmindspartners.com" class="nav-cta">Hablemos <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg></a></div>
    </div>
  </nav>

  <header class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="page-hero-overlay" aria-hidden="true"></div>
    <div class="wrap">
      <div class="page-hero-content">
        <div class="page-eyebrow live">Plataformas</div>
        <h1>Herramientas que construimos. <em>Aplicadas a engagements en vivo.</em></h1>
        <p>{live.length} en producción, {inDev.length} en desarrollo. Disponibles para clientes hoy — lanzamiento público próximamente.</p>
      </div>
    </div>
  </header>

  <section class="products">

    <div class="product-section-header">
      <div class="product-section-header-inner">
        <div>
          <div class="product-section-eyebrow">En producción</div>
          <h2 class="product-section-title">Plataformas en vivo ({live.length})</h2>
        </div>
        <p class="product-section-note">Desplegadas y en uso activo en los engagements LatAm.</p>
      </div>
    </div>

    {live.map((p, i) => {
      const idx = stripeIndex++;
      const bg = stripeBg(idx);
      const reverse = idx % 2 === 1;
      const num = String(i + 1).padStart(2, '0');
      const labelMap = {
        'See demo →': 'Ver demo →',
        'Subscribe for free →': 'Suscribirse gratis →',
      };
      const ctaHref = p.ctaHref ?? p.url ?? '/es/contact';
      const rawLabel = p.ctaLabel ?? (p.url ? 'Abrir plataforma →' : 'Hablemos →');
      const ctaLabel = labelMap[rawLabel as keyof typeof labelMap] ?? rawLabel;
      const external = ctaHref.startsWith('http');
      return (
        <article class={`product reveal ${reverse ? 'reverse' : ''}`}>
          <div class={`product-info on-${bg}`}>
            <div class="product-meta-row">
              <div class="product-info-num">{num} — {p.tag}</div>
              <StatusBadge status={p.status} locale="es" />
            </div>
            <h3>{p.name}</h3>
            <p>{p.tagline}</p>
            {p.subtagline && <p class="product-subtag">{p.subtagline}</p>}
            <a class="product-cta" href={ctaHref} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>{ctaLabel}</a>
          </div>
          <div class="product-visual"><div class="product-visual-bg" style={`background-image: url('${p.cardImage}');`}></div></div>
        </article>
      );
    })}

    <div class="product-section-header">
      <div class="product-section-header-inner">
        <div>
          <div class="product-section-eyebrow">En desarrollo</div>
          <h2 class="product-section-title">Próximamente ({inDev.length})</h2>
        </div>
        <p class="product-section-note">En uso hoy en engagements. Lanzamiento público próximamente.</p>
      </div>
    </div>

    {inDev.map((p, i) => {
      const idx = stripeIndex++;
      const bg = stripeBg(idx);
      const reverse = idx % 2 === 1;
      const num = String(live.length + i + 1).padStart(2, '0');
      const ctaHref = p.ctaHref ?? '/es/contact';
      const ctaLabel = 'Avísame cuando esté listo →';
      return (
        <article class={`product product--soon reveal ${reverse ? 'reverse' : ''}`}>
          <div class={`product-info on-${bg}`}>
            <div class="product-meta-row">
              <div class="product-info-num">{num} — {p.tag}</div>
              <StatusBadge status={p.status} locale="es" />
            </div>
            <h3>{p.name}</h3>
            <p>{p.tagline}</p>
            {p.subtagline && <p class="product-subtag">{p.subtagline}</p>}
            <a class="product-cta" href={ctaHref}>{ctaLabel}</a>
          </div>
          <div class="product-visual"><div class="product-visual-bg" style={`background-image: url('${p.cardImage}');`}></div></div>
        </article>
      );
    })}

  </section>

  <footer>
    <div class="foot-links">
      <div class="foot-brand-cell">
        <a class="brand" href="/es/"><img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" /></a>
        <p>La firma de inteligencia DC de América Latina.</p>
        <div class="foot-social" aria-label="Síguenos">
          <a href="https://www.linkedin.com/company/cloud-minds-partners" aria-label="LinkedIn" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.97 0 1.77-.77 1.77-1.72V1.72C24 .77 23.2 0 22.23 0z"/></svg></a>
          <a href="https://wa.me/5511915788796" aria-label="WhatsApp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.4.5-.6.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3 4.8 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4 0-.1-.3-.2-.5-.3zM12 22a10 10 0 0 1-5-1.3L2 22l1.3-5A10 10 0 1 1 12 22zm0-18.2A8.2 8.2 0 0 0 4.6 16l-.2.5-.8 3 3-.8.5.2c1.2.7 2.6 1.1 4 1.1 4.5 0 8.2-3.7 8.2-8.2S16.5 3.8 12 3.8z"/></svg></a>
        </div>
      </div>
      <div><h4>Plataformas</h4><ul><li><a href="/es/platforms">Site Screening Tool</a></li><li><a href="/es/platforms">Grid Intelligence</a></li><li><a href="/es/platforms">DC Insights</a></li><li><a href="/es/platforms">DC Test Fit Pro</a></li><li><a href="/es/platforms">DC Financial Model</a></li></ul></div>
      <div><h4>Inteligencia</h4><ul><li><a href="/es/intelligence">Memos Técnicos</a></li><li><a href="/es/intelligence">Radar de Innovación</a></li><li><a href="/es/intelligence">Vigilancia Regulatoria</a></li><li><a href="/es/intelligence">Pulse Semanal</a></li></ul></div>
      <div><h4>Empresa</h4><ul><li><a href="/es/advisory">Asesoría</a></li><li><a href="/es/development">Desarrollo</a></li><li><a href="/es/team">Equipo</a><a href="/es/contact">Contacto</a></li></ul></div>
      <div><h4>Contacto</h4><ul><li><a href="mailto:info@cloudmindspartners.com">info@cloudmindspartners.com</a></li><li>São Paulo · BR</li><li>Santiago · CL</li><li>Ciudad de México · MX</li></ul></div>
    </div>
    <div class="foot-bottom"><span>© 2026 Cloud Minds Partners</span><span>Todos los derechos reservados.</span></div>
  </footer>

  <script is:inline>
    const observer = new IntersectionObserver((entries) => { entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }); }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</Base>
