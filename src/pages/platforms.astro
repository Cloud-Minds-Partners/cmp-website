---
import Base from '../layouts/Base.astro';
import SEO from '../components/SEO.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { livePlatforms, inDevelopmentPlatforms } from '../data/platforms';

const live = livePlatforms();
const inDev = inDevelopmentPlatforms();

// Continuous alternation across both sections for the stripe pattern
let stripeIndex = 0;
const stripeBg = (i: number) => (i % 2 === 0 ? 'navy' : 'cream');
import LegalEntity from "../components/LegalEntity.astro";
---

<Base lang="en">
  <SEO
    slot="head"
    title="Platforms — Cloud Minds Partners"
    description="Tools we built. In production and in development. Applied to live engagements across LatAm."
    image="/og/platforms.png"
  />

  <style slot="head" is:global>
    .page-hero-bg { background-image: url("/photos/hero-platforms.jpg"); }

    .products { padding: 0; }
    .product-section-header {
      background: var(--navy-0);
      padding: clamp(48px, 6vw, 80px) clamp(24px, 4vw, 64px);
      border-top: 1px solid rgba(255,255,255,0.06);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .product-section-header-inner {
      max-width: 1280px; margin: 0 auto;
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 24px; flex-wrap: wrap;
    }
    .product-section-eyebrow {
      font-family: var(--font-body); font-size: 12px;
      font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--blue-bright);
    }
    .product-section-title {
      font-family: var(--font-display);
      font-size: clamp(24px, 2.6vw, 32px);
      font-weight: 600; line-height: 1.15;
      color: var(--cream-0); margin: 6px 0 0 0;
    }
    .product-section-note {
      font-family: var(--font-body); font-size: 14px;
      color: var(--cream-1); max-width: 42ch;
      margin: 0;
    }

    .product {
      display: grid; grid-template-columns: 1fr 1fr;
      align-items: stretch;
      width: 100%;
    }
    .product-info {
      padding: clamp(56px, 8vh, 96px) clamp(48px, 6vw, 96px);
      display: flex; flex-direction: column; gap: 18px;
      align-items: center; justify-content: center;
      text-align: center;
    }
    .product-meta-row {
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
      justify-content: center;
    }
    .product-info-num {
      font-family: var(--font-body); font-size: 12.5px;
      font-weight: 600; letter-spacing: 0;
      color: var(--blue-bright);
    }
    .product-info h3 {
      font-family: var(--font-display); font-size: clamp(28px, 3.2vw, 40px);
      line-height: 1.1; letter-spacing: var(--track-display);
      font-weight: 600; margin: 0;
      color: var(--cream-0);
      max-width: 16ch;
    }
    .product-info > p {
      font-size: 15.5px; line-height: 1.55;
      color: var(--cream-1); margin: 0;
      max-width: 38ch;
    }
    .product-subtag {
      font-size: 13.5px; line-height: 1.5;
      color: var(--cream-2); font-style: italic;
      margin: 4px 0 0; max-width: 38ch;
    }
    .product-info.on-cream .product-subtag { color: #6B7B92; }
    /* In Development cards: subtle visual cue */
    .product--soon .product-visual-bg { filter: saturate(0.5) brightness(0.85); }
    .product--soon .product-info { background-image: linear-gradient(180deg, rgba(148,163,184,0.04) 0%, transparent 100%); }
    .product-cta {
      margin-top: 8px;
      display: inline-flex; align-items: center; gap: 10px;
      font-size: 14px; font-weight: 600;
      color: var(--blue-bright);
      padding-bottom: 4px;
      border-bottom: 1px solid var(--blue-bright);
      transition: gap var(--t-fast);
    }
    .product-cta:hover { gap: 16px; color: var(--cream-0); }

    .product-info.on-navy { background: var(--navy-0); }
    .product-info.on-cream { background: var(--cream-bg); color: var(--navy-0); }
    .product-info.on-cream h3 { color: var(--navy-0); }
    .product-info.on-cream > p { color: #4D5F7A; }
    .product-info.on-cream .product-info-num { color: var(--blue-deep); }
    .product-info.on-cream .product-cta { color: var(--blue); border-color: var(--blue); }
    .product-info.on-cream .product-cta:hover { color: var(--navy-0); }

    .product.reverse .product-info { order: 2; }
    .product.reverse .product-visual { order: 1; }

    .product-visual { position: relative; min-height: 480px; overflow: hidden; background: var(--navy-0); }
    .product-visual-bg {
      position: absolute; inset: 0;
      background-size: cover; background-position: center;
      animation: prodKen 22s ease-in-out infinite alternate;
      filter: saturate(1.15) contrast(1.05);
    }
    .product-visual-video {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: contain;
      background: var(--navy-0);
      display: block;
    }
    @keyframes prodKen { 0% { transform: scale(1); } 100% { transform: scale(1.07); } }

    @media (max-width: 880px) {
      .product { grid-template-columns: 1fr; }
      .product-visual { min-height: 280px; }
      .product.reverse .product-info { order: 1; }
      .product.reverse .product-visual { order: 2; }
      .product-section-header-inner { flex-direction: column; align-items: flex-start; }
    }
  </style>

  <nav class="nav">
    <div class="nav-inner">
      <a class="brand" href="/"><img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" /></a>
      <div class="nav-links"><a href="/advisory">Advisory</a><a href="/development">Development</a><a href="/intelligence">Intelligence</a><a href="/platforms" class="active">Platforms</a><a href="/team">Team</a><a href="/contact">Contact</a></div>
      <div class="nav-right"><div class="nav-lang">
        <a href="/platforms" class="active">EN</a><span class="sep">·</span><a href="/pt/platforms">PT</a><span class="sep">·</span><a href="/es/platforms">ES</a>
      </div>
      <a href="mailto:info@cloudmindspartners.com" class="nav-cta">Talk to us <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg></a></div>
    </div>
  </nav>

  <header class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="page-hero-overlay" aria-hidden="true"></div>
    <div class="wrap">
      <div class="page-hero-content">
        <div class="page-eyebrow live">Platforms</div>
        <h1>Tools we built. <em>Applied to live engagements.</em></h1>
        <p>{live.length} in production, {inDev.length} in development. Available to clients today — public launch coming soon.</p>
      </div>
    </div>
  </header>

  <section class="products">

    <div class="product-section-header">
      <div class="product-section-header-inner">
        <div>
          <div class="product-section-eyebrow">In Production</div>
          <h2 class="product-section-title">Live platforms ({live.length})</h2>
        </div>
        <p class="product-section-note">Deployed, in active use across LatAm engagements.</p>
      </div>
    </div>

    {live.map((p, i) => {
      const idx = stripeIndex++;
      const bg = stripeBg(idx);
      const reverse = idx % 2 === 1;
      const num = String(i + 1).padStart(2, '0');
      const ctaHref = p.ctaHref ?? p.url ?? '/contact';
      const ctaLabel = p.ctaLabel ?? (p.url ? 'Open platform →' : 'Talk to us →');
      const external = ctaHref.startsWith('http');
      return (
        <article class={`product reveal ${reverse ? 'reverse' : ''}`}>
          <div class={`product-info on-${bg}`}>
            <div class="product-meta-row">
              <div class="product-info-num">{num} — {p.tag}</div>
              <StatusBadge status={p.status} locale="en" />
            </div>
            <h3>{p.name}</h3>
            <p>{p.tagline}</p>
            {p.subtagline && <p class="product-subtag">{p.subtagline}</p>}
            <a class="product-cta" href={ctaHref} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>{ctaLabel}</a>
          </div>
          <div class="product-visual">
            {p.videoUrl ? (
              <video
                id={`video-${p.slug}`}
                class="product-visual-video"
                src={p.videoUrl}
                poster={p.cardImage}
                controls
                preload="metadata"
                playsinline
                data-product-video
              ></video>
            ) : (
              <div class="product-visual-bg" style={`background-image: url('${p.cardImage}');`}></div>
            )}
          </div>
        </article>
      );
    })}

    <div class="product-section-header">
      <div class="product-section-header-inner">
        <div>
          <div class="product-section-eyebrow">In Development</div>
          <h2 class="product-section-title">Coming next ({inDev.length})</h2>
        </div>
        <p class="product-section-note">Used today on engagements. Launching publicly soon.</p>
      </div>
    </div>

    {inDev.map((p, i) => {
      const idx = stripeIndex++;
      const bg = stripeBg(idx);
      const reverse = idx % 2 === 1;
      const num = String(live.length + i + 1).padStart(2, '0');
      const ctaHref = p.ctaHref ?? '/contact';
      const ctaLabel = p.ctaLabel ?? 'Notify me when it ships →';
      return (
        <article class={`product product--soon reveal ${reverse ? 'reverse' : ''}`}>
          <div class={`product-info on-${bg}`}>
            <div class="product-meta-row">
              <div class="product-info-num">{num} — {p.tag}</div>
              <StatusBadge status={p.status} locale="en" />
            </div>
            <h3>{p.name}</h3>
            <p>{p.tagline}</p>
            {p.subtagline && <p class="product-subtag">{p.subtagline}</p>}
            <a class="product-cta" href={ctaHref}>{ctaLabel}</a>
          </div>
          <div class="product-visual"><div class="product-visual-bg" style={`background-image: url('${p.cardImage}');`}></div></div>
        </article>
      );
    })}

  </section>

  <footer>
    <div class="foot-links">
      <div class="foot-brand-cell">
        <a class="brand" href="/"><img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" /></a>
        <p>The LatAm DC intelligence firm.</p>
        <div class="foot-social" aria-label="Follow us">
          <a class="social-linkedin" href="https://www.linkedin.com/company/cloud-minds-partners" aria-label="LinkedIn" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg></a>
          <a class="social-whatsapp" href="https://wa.me/5511915788796" aria-label="WhatsApp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></a>
        </div>
      </div>
      <div><h3>Platforms</h3><ul><li><a href="/platforms">Site Screening Tool</a></li><li><a href="/platforms">Grid Intelligence</a></li><li><a href="/platforms">DC Insights</a></li><li><a href="/platforms">DC Test Fit Pro</a></li><li><a href="/platforms">DC Financial Model</a></li></ul></div>
      <div><h3>Intelligence</h3><ul><li><a href="/intelligence">Technical Memos</a></li><li><a href="/intelligence">Innovation Radar</a></li><li><a href="/intelligence">Regulatory Watch</a></li><li><a href="/intelligence">Weekly Pulse</a></li></ul></div>
      <div><h3>Company</h3><ul><li><a href="/advisory">Advisory</a></li><li><a href="/development">Development</a></li><li><a href="/team">Team</a></li><li><a href="/contact">Contact</a></li></ul></div>
      <div><h3>Contact</h3><ul><li><a href="mailto:info@cloudmindspartners.com">info@cloudmindspartners.com</a></li><li><a href="tel:+5511915788796">+55 11 91578-8796</a></li><li>São Paulo · BR</li><li>Santiago · CL</li><li>Mexico City · MX</li></ul></div>
    </div>
    <LegalEntity />
    <div class="foot-bottom"><span>© 2026 Cloud Minds Partners</span><span>All rights reserved.</span></div>
  </footer>

  <script is:inline>
    const observer = new IntersectionObserver((entries) => { entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }); }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // CTA "See demo" → play inline product video instead of navigating
    document.querySelectorAll('a.product-cta[href^="#video-"]').forEach((link) => {
      link.addEventListener('click', (ev) => {
        const id = link.getAttribute('href').slice(1);
        const video = document.getElementById(id);
        if (!video) return;
        ev.preventDefault();
        video.scrollIntoView({ behavior: 'smooth', block: 'center' });
        video.play().catch(() => { /* user gesture not granted — controls still visible */ });
      });
    });
  </script>
</Base>
