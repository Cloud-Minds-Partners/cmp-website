---
import Base from '../../layouts/Base.astro';
import SEO from '../../components/SEO.astro';

const pulses = [
  { num: '10', date: 'Jun 16', dateIso: '2026-06-16', tag: 'Orbital · LatAm', title: "Compute leaves Earth.", summary: 'Four signals that moved data center markets.', cover: '/photos/pulse-10-cover.png', featured: true },
  { num: '09', date: 'Jun 9',  dateIso: '2026-06-09', tag: 'Brazil · Grid', title: "Brazilian grid sets the terms.", summary: 'Three signals that moved data center markets.', cover: '/photos/pulse-09-cover.png' },
  { num: '08', date: 'Jun 2',  dateIso: '2026-06-02', tag: 'LatAm · Capital', title: "Latin America's $17.6B buildout.", summary: 'Two signals that moved data center markets.', cover: '/photos/pulse-08-cover.png' },
  { num: '07', date: 'May 26', dateIso: '2026-05-26', tag: 'Power · Regulatory', title: "Brazil's wind goes hyperscale.", summary: 'Four signals that moved data center markets.', cover: '/photos/pulse-07-cover.png' },
  { num: '06', date: 'May 19', dateIso: '2026-05-19', tag: 'Power', title: 'Google heads off Earth.', summary: 'Four signals that moved data center markets.', cover: '/photos/pulse-06-cover.png' },
  { num: '05', date: 'May 12', dateIso: '2026-05-12', tag: 'Grid · Regulatory', title: 'Chile clears. Europe waits.', summary: 'AWS Atacama unlock vs Energinet pause. The geography of clearance shifted.' },
  { num: '04', date: 'May 5',  dateIso: '2026-05-05', tag: 'Capital', title: 'From frontier to allocated.', summary: 'I Squared acquires Elea. Big Four projects US$ 725B 2026 capex. Brazil crosses 1 GW.' },
  { num: '03', date: 'Apr 28', dateIso: '2026-04-28', tag: 'Power · Frontier', title: 'The grid is no longer the only path to power.', summary: 'Bloom Energy, Meta + Overview Energy orbital solar, Equinix SP6 in São Paulo.' },
  { num: '02', date: 'Apr 21', dateIso: '2026-04-21', tag: 'Markets · LatAm', title: 'Tecto bets US$ 2B on LatAm.', summary: 'Brazilian-based platform pledges regional expansion through 2028. Wyoming emerges as a first-tier frontier.' },
  { num: '01', date: 'Apr 13', dateIso: '2026-04-13', tag: 'Macro', title: 'The week in global data centers.', summary: 'PJM 15 GW emergency auction, Meta + CoreWeave US$ 21B compute deal, Blackstone DC REIT.' },
];

const featured = pulses[0];
const archive = pulses;
const linkedinUrl = 'https://www.linkedin.com/company/cloud-minds-partners/posts/';
import LegalEntity from "../../components/LegalEntity.astro";
---

<Base lang="en">
  <SEO
    slot="head"
    title="Intelligence — Cloud Minds Partners"
    description="DC Weekly Pulse and research streams on LatAm data center markets. Primary sources, audited claim-by-claim."
    image="/og/intelligence.png"
  />

  <style slot="head" is:global>
    .page-hero-bg { background-image: url("/photos/hero-intelligence.jpg"); filter: saturate(1.1) contrast(1.05) brightness(0.85); }

    .streams { background: var(--navy-1); border-bottom: 1px solid var(--line-0); position: sticky; top: 72px; z-index: 30; }
    .streams-inner { display: flex; max-width: var(--max-w); margin: 0 auto; }
    .streams-tab { padding: 18px clamp(20px, 3vw, 36px); font-size: 15px; color: var(--cream-1); font-weight: 600; font-family: var(--font-display); letter-spacing: -0.005em; border-right: 1px solid var(--line-0); transition: background var(--t-fast), color var(--t-fast); position: relative; cursor: pointer; }
    .streams-tab:first-child { border-left: 1px solid var(--line-0); margin-left: var(--gutter); }
    .streams-tab:hover { background: var(--navy-2); color: var(--cream-0); }
    .streams-tab.active { color: var(--cream-0); background: var(--navy-2); }
    .streams-tab.active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: var(--blue-bright); }
    .streams-badge { display: inline-block; margin-left: 10px; font-family: var(--font-body); font-size: 10.5px; font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase; padding: 3px 8px; border-radius: 999px; vertical-align: middle; }
    .streams-badge.live { background: rgba(74,222,128,0.12); color: #4ADE80; border: 1px solid rgba(74,222,128,0.35); }
    .streams-badge.dev { background: rgba(148,163,184,0.10); color: #94a3b8; border: 1px solid rgba(148,163,184,0.30); }

    /* Pulse hero */
    .pulse-section { background: var(--cream-bg); color: var(--navy-0); padding: clamp(72px, 10vh, 120px) 0; border-top: 1px solid rgba(5,14,29,0.06); }
    .pulse-inner { max-width: var(--max-w); margin: 0 auto; padding: 0 var(--gutter); }
    .pulse-featured { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(48px, 6vw, 96px); align-items: center; }
    .pulse-cover-frame { aspect-ratio: 1/1; position: relative; overflow: hidden; border: 1px solid rgba(5,14,29,0.08); border-radius: 12px; background: #0a1d3a; box-shadow: 0 24px 48px rgba(5,14,29,0.12); }
    .pulse-cover-frame img { width: 100%; height: 100%; object-fit: cover; }
    .pulse-cover-tag { position: absolute; bottom: 18px; right: 18px; z-index: 2; font-family: var(--font-body); font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #fff; background: #0d9488; padding: 8px 14px; border-radius: 999px; box-shadow: 0 6px 18px rgba(13,148,136,0.45); }
    .pulse-eyebrow { font-family: var(--font-body); font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--blue-deep); display: inline-flex; align-items: center; gap: 10px; }
    .pulse-eyebrow::before { content: ""; width: 22px; height: 1px; background: var(--blue-deep); }
    .pulse-title { font-family: var(--font-display); font-size: clamp(28px, 3.4vw, 44px); line-height: 1.05; letter-spacing: var(--track-display); font-weight: 600; margin: 16px 0 0; color: var(--navy-0); max-width: 14ch; }
    .pulse-summary { margin: 22px 0 0; font-size: 16px; line-height: 1.6; color: #4D5F7A; max-width: 500px; }
    .pulse-meta { margin-top: 28px; display: flex; gap: 28px; padding-top: 20px; border-top: 1px solid rgba(5,14,29,0.10); font-family: var(--font-body); font-size: 12.5px; color: #6B7B92; }
    .pulse-meta strong { display: block; color: var(--navy-0); font-weight: 600; font-size: 14px; margin-bottom: 4px; }
    .pulse-cta { display: inline-flex; align-items: center; gap: 12px; margin-top: 28px; font-size: 14px; font-weight: 600; color: var(--blue); padding-bottom: 4px; border-bottom: 1px solid var(--blue); transition: gap var(--t-fast); }
    .pulse-cta:hover { gap: 18px; color: var(--navy-0); }

    /* Archive */
    .pulse-archive { margin-top: clamp(80px, 10vh, 120px); }
    .pulse-archive-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 32px; }
    .pulse-archive-header h2 { font-family: var(--font-display); font-size: clamp(22px, 2.6vw, 32px); margin: 0; letter-spacing: var(--track-display); color: var(--navy-0); font-weight: 600; }
    .pulse-archive-header-count { font-family: var(--font-body); font-size: 13px; color: #6B7B92; letter-spacing: 0; }
    .pulse-archive-grid { display: flex; flex-direction: column; border-top: 1px solid rgba(5,14,29,0.10); }
    .pulse-row { display: grid; grid-template-columns: 88px 1fr 160px; gap: clamp(20px, 2.6vw, 40px); padding: 24px 12px; border-bottom: 1px solid rgba(5,14,29,0.08); transition: background var(--t-fast); align-items: center; }
    .pulse-row:hover { background: rgba(5,14,29,0.03); }
    .pulse-row-num { font-family: var(--font-display); font-size: 13px; font-weight: 600; color: #6B7B92; letter-spacing: 0; }
    .pulse-row-num strong { display: block; font-family: var(--font-display); font-size: 22px; font-weight: 600; color: var(--navy-0); letter-spacing: -0.012em; margin-bottom: 2px; }
    .pulse-row-body h3 { font-family: var(--font-display); font-size: 17px; font-weight: 600; letter-spacing: -0.008em; margin: 0 0 6px; color: var(--navy-0); }
    .pulse-row-body p { font-size: 13.5px; line-height: 1.55; color: #4D5F7A; margin: 0; max-width: 620px; }
    .pulse-row-tag { display: inline-block; font-family: var(--font-body); font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--blue-deep); padding: 3px 8px; border: 1px solid rgba(45,107,228,0.25); border-radius: 999px; margin-top: 10px; background: rgba(45,107,228,0.04); }
    .pulse-row-action { text-align: right; font-family: var(--font-body); font-size: 13px; color: var(--blue); font-weight: 600; }

    /* In-development streams */
    .streams-stack { background: var(--navy-0); padding: clamp(72px, 10vh, 120px) 0; }
    .stream-card { max-width: var(--max-w); margin: 0 auto clamp(32px, 4vh, 48px); padding: 0 var(--gutter); }
    .stream-card-inner { display: grid; grid-template-columns: 1fr 320px; gap: clamp(32px, 4vw, 64px); align-items: center; padding: 40px clamp(28px, 3vw, 48px); border: 1px solid var(--line-0); border-radius: 16px; background: linear-gradient(180deg, rgba(255,255,255,0.02) 0%, transparent 100%); }
    .stream-card-tag { font-family: var(--font-body); font-size: 11px; font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase; color: #94a3b8; background: rgba(148,163,184,0.08); border: 1px solid rgba(148,163,184,0.25); padding: 4px 10px; border-radius: 999px; display: inline-flex; align-items: center; gap: 6px; }
    .stream-card-tag::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: #94a3b8; }
    .stream-card h3 { font-family: var(--font-display); font-size: clamp(22px, 2.6vw, 32px); font-weight: 600; letter-spacing: -0.012em; margin: 18px 0 14px; color: var(--cream-0); }
    .stream-card p { font-size: 15px; line-height: 1.6; color: var(--cream-1); margin: 0; max-width: 56ch; }
    .stream-card-cta-block { display: flex; flex-direction: column; gap: 12px; padding-left: clamp(0px, 3vw, 32px); border-left: 1px solid var(--line-0); }
    .stream-card-cta-label { font-family: var(--font-body); font-size: 11.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cream-3); }
    .stream-card-cta { display: inline-flex; align-items: center; gap: 10px; padding: 12px 18px; background: var(--blue-bright); color: var(--navy-0); border-radius: 999px; font-size: 14px; font-weight: 600; transition: gap var(--t-fast); }
    .stream-card-cta:hover { gap: 16px; }

    @media (max-width: 880px) {
      .pulse-featured { grid-template-columns: 1fr; }
      .pulse-row { grid-template-columns: 1fr; }
      .pulse-row-action { text-align: left; }
      .stream-card-inner { grid-template-columns: 1fr; }
      .stream-card-cta-block { padding-left: 0; border-left: 0; border-top: 1px solid var(--line-0); padding-top: 20px; }
      .streams-inner { overflow-x: auto; }
    }
  </style>

  <nav class="nav">
    <div class="nav-inner">
      <a class="brand" href="/"><img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" /><span class="brand-tag">The LatAm DC intelligence firm.</span></a>
      <div class="nav-links"><a href="/advisory">Advisory</a><a href="/development">Development</a><a href="/intelligence" class="active">Intelligence</a><a href="/platforms">Platforms</a><a href="/team">Team</a><a href="/contact">Contact</a></div>
      <div class="nav-right"><div class="nav-lang">
        <a href="/intelligence" class="active">EN</a><span class="sep">·</span><a href="/pt/intelligence">PT</a><span class="sep">·</span><a href="/es/intelligence">ES</a>
      </div>
      <a href="mailto:info@cloudmindspartners.com" class="nav-cta">Talk to us <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg></a></div>
    </div>
  </nav>

  <header class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="page-hero-overlay" aria-hidden="true"></div>
    <div class="wrap">
      <div class="page-hero-content">
        <div class="page-eyebrow live">Intelligence</div>
        <h1>Research on <em>LatAm</em> data center markets.</h1>
        <p>Four streams. Primary sources. Audited claim-by-claim.</p>
      </div>
    </div>
  </header>

  <div class="streams">
    <div class="streams-inner">
      <a class="streams-tab active" href="#pulse">Weekly Pulse <span class="streams-badge live">Live</span></a>
      <a class="streams-tab" href="#memos">Technical Memos <span class="streams-badge dev">Soon</span></a>
      <a class="streams-tab" href="#radar">Innovation Radar <span class="streams-badge dev">Soon</span></a>
      <a class="streams-tab" href="#regwatch">Regulatory Watch <span class="streams-badge dev">Soon</span></a>
    </div>
  </div>

  <section class="pulse-section" id="pulse">
    <div class="pulse-inner">
      <div class="pulse-featured reveal">
        <div class="pulse-cover-frame">
          <img src={featured.cover} alt={`DC Weekly Pulse #${featured.num} cover`} loading="lazy" />
          <span class="pulse-cover-tag">Pulse {featured.num} · This week</span>
        </div>
        <div>
          <div class="pulse-eyebrow">Latest · Weekly Pulse</div>
          <h2 class="pulse-title">{featured.title}</h2>
          <p class="pulse-summary">{featured.summary}</p>
          <div class="pulse-meta">
            <span><strong>Pulse {featured.num}</strong>{featured.date}, 2026</span>
            <span><strong>{featured.tag}</strong>Category</span>
            <span><strong>~1 min</strong>To watch</span>
          </div>
          <a href={linkedinUrl} class="pulse-cta" target="_blank" rel="noopener">
            Watch on LinkedIn
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg>
          </a>
        </div>
      </div>

      <div class="pulse-archive">
        <div class="pulse-archive-header">
          <h2>Archive</h2>
          <span class="pulse-archive-header-count">{archive.length} editions · published weekly</span>
        </div>
        <div class="pulse-archive-grid">
          {archive.map((p) => (
            <a class="pulse-row reveal" href={linkedinUrl} target="_blank" rel="noopener">
              <div class="pulse-row-num">
                <strong>#{p.num}</strong>{p.date}
              </div>
              <div class="pulse-row-body">
                <h3>{p.title}</h3>
                <p>{p.summary}</p>
                <span class="pulse-row-tag">{p.tag}</span>
              </div>
              <div class="pulse-row-action">Watch on LinkedIn →</div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="streams-stack">
    <div class="stream-card" id="memos">
      <div class="stream-card-inner reveal">
        <div>
          <span class="stream-card-tag">In development</span>
          <h3>Technical Memos</h3>
          <p>Multi-page primary-source research briefs on regulatory, fiscal, and grid developments shaping LatAm data center investment. Each memo audited claim-by-claim before publication.</p>
        </div>
        <div class="stream-card-cta-block">
          <div class="stream-card-cta-label">Notify me when first memo publishes</div>
          <a href="/contact" class="stream-card-cta">
            Stay informed
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="stream-card" id="radar">
      <div class="stream-card-inner reveal">
        <div>
          <span class="stream-card-tag">In development</span>
          <h3>Innovation Radar</h3>
          <p>Weekly technology and market signals for LatAm DC professionals — infrastructure, AI, competitive moves, and regulatory shifts. Distilled to what matters.</p>
        </div>
        <div class="stream-card-cta-block">
          <div class="stream-card-cta-label">Get the first edition</div>
          <a href="/contact" class="stream-card-cta">
            Stay informed
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="stream-card" id="regwatch">
      <div class="stream-card-inner reveal">
        <div>
          <span class="stream-card-tag">In development</span>
          <h3>Regulatory Watch</h3>
          <p>Monthly digest of regulatory changes affecting LatAm data center investment — across seven jurisdictions. Permitting, tax, telecom, environmental.</p>
        </div>
        <div class="stream-card-cta-block">
          <div class="stream-card-cta-label">Subscribe to the digest</div>
          <a href="/contact" class="stream-card-cta">
            Stay informed
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M7 1l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <div class="foot-links">
      <div class="foot-brand-cell">
        <a class="brand" href="/"><img class="brand-wordmark" src="/logo/cmp-wordmark.png" alt="Cloud Minds Partners" /></a>
        <p>The LatAm DC intelligence firm.</p>
        <div class="foot-social" aria-label="Follow us">
          <a href="https://www.linkedin.com/company/cloud-minds-partners" aria-label="LinkedIn" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.97 0 1.77-.77 1.77-1.72V1.72C24 .77 23.2 0 22.23 0z"/></svg></a>
          <a href="https://wa.me/5511915788796" aria-label="WhatsApp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.4.5-.6.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3 4.8 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4 0-.1-.3-.2-.5-.3zM12 22a10 10 0 0 1-5-1.3L2 22l1.3-5A10 10 0 1 1 12 22zm0-18.2A8.2 8.2 0 0 0 4.6 16l-.2.5-.8 3 3-.8.5.2c1.2.7 2.6 1.1 4 1.1 4.5 0 8.2-3.7 8.2-8.2S16.5 3.8 12 3.8z"/></svg></a>
        </div>
      </div>
      <div><h4>Platforms</h4><ul><li><a href="/platforms">Site Screening Tool</a></li><li><a href="/platforms">Grid Intelligence</a></li><li><a href="/platforms">DC Insights</a></li><li><a href="/platforms">DC Test Fit Pro</a></li><li><a href="/platforms">DC Financial Model</a></li></ul></div>
      <div><h4>Intelligence</h4><ul><li><a href="/intelligence#pulse">Weekly Pulse</a></li><li><a href="/intelligence#memos">Technical Memos</a></li><li><a href="/intelligence#radar">Innovation Radar</a></li><li><a href="/intelligence#regwatch">Regulatory Watch</a></li></ul></div>
      <div><h4>Company</h4><ul><li><a href="/advisory">Advisory</a></li><li><a href="/development">Development</a></li><li><a href="/team">Team</a><a href="/contact">Contact</a></li></ul></div>
      <div><h4>Contact</h4><ul><li><a href="mailto:info@cloudmindspartners.com">info@cloudmindspartners.com</a></li><li><a href="tel:+5511915788796">+55 11 91578-8796</a></li><li>São Paulo · BR</li><li>Santiago · CL</li><li>Mexico City · MX</li></ul></div>
    </div>
    <LegalEntity />
    <div class="foot-bottom"><span>© 2026 Cloud Minds Partners</span><span>All rights reserved.</span></div>
  </footer>

  <script is:inline>
    const observer = new IntersectionObserver((entries) => { entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }); }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</Base>
