---
type Status = "live" | "beta" | "in-development";

interface Props {
  status: Status;
  locale?: "en" | "pt" | "es";
}

const { status, locale = "en" } = Astro.props;

const labels: Record<Status, Record<"en" | "pt" | "es", string>> = {
  live: { en: "Live", pt: "Em produção", es: "En producción" },
  beta: { en: "Beta", pt: "Beta", es: "Beta" },
  "in-development": {
    en: "In development",
    pt: "Em desenvolvimento",
    es: "En desarrollo",
  },
};
---
<span class={`status-badge status-${status}`} data-status={status}>
  <span class="status-dot" aria-hidden="true"></span>
  {labels[status][locale]}
</span>

<style is:global>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px 4px 8px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-family: var(--font-body);
    line-height: 1;
    white-space: nowrap;
    border: 1px solid transparent;
  }
  .status-badge .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .status-live {
    color: #4ade80;
    background: rgba(74, 222, 128, 0.08);
    border-color: rgba(74, 222, 128, 0.25);
  }
  .status-live .status-dot {
    background: #4ade80;
    box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.18);
  }
  .status-beta {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.08);
    border-color: rgba(251, 191, 36, 0.25);
  }
  .status-in-development {
    color: #94a3b8;
    background: rgba(148, 163, 184, 0.08);
    border-color: rgba(148, 163, 184, 0.22);
  }
  /* Variant for cream backgrounds */
  .product-info.on-cream .status-live {
    color: #047857;
    background: rgba(4, 120, 87, 0.08);
    border-color: rgba(4, 120, 87, 0.25);
  }
  .product-info.on-cream .status-live .status-dot {
    background: #047857;
    box-shadow: 0 0 0 3px rgba(4, 120, 87, 0.15);
  }
  .product-info.on-cream .status-in-development {
    color: #475569;
    background: rgba(71, 85, 105, 0.08);
    border-color: rgba(71, 85, 105, 0.2);
  }
</style>
