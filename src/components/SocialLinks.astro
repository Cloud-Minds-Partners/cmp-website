---
import { social } from "../config/social";

interface Props {
  variant?: "header" | "footer";
  class?: string;
}

const { variant = "footer", class: className = "" } = Astro.props;

const waMessage = encodeURIComponent(social.whatsappDefaultMessage);
const waHref = `https://wa.me/${social.whatsappNumber}?text=${waMessage}`;
---

{variant === "footer" ? (
  <div class={`foot-social ${className}`}>
    <a
      href={social.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Cloud Minds on LinkedIn"
      class="social-icon-link social-linkedin"
    >
      <!-- LinkedIn SVG 16x16 -->
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452z"/>
      </svg>
    </a>
    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat on WhatsApp"
      class="social-icon-link social-whatsapp"
    >
      <!-- WhatsApp SVG 16x16 -->
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
    </a>
  </div>
) : (
  <div class={`header-social ${className}`}>
    <a
      href={social.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Cloud Minds on LinkedIn"
      class="header-icon-link"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452z"/>
      </svg>
    </a>
    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat on WhatsApp"
      class="header-icon-link"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
    </a>
  </div>
)}

<style>
  /* Footer variant — disco na cor da marca, glifo branco.
     Espelha .foot-social de global.css e o .wa-fab: um tratamento só de ícone
     no site inteiro, seja a página que usa markup inline ou esta que usa o
     componente (404 e as páginas de intelligence). */
  .foot-social {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .foot-social .social-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    color: #FFFFFF;
    text-decoration: none;
    transition: transform 0.18s, filter 0.18s, box-shadow 0.18s;
  }
  .foot-social .social-linkedin { background: #0A66C2; }
  .foot-social .social-whatsapp { background: #25D366; }
  .foot-social .social-icon-link:hover {
    transform: translateY(-2px);
    filter: brightness(1.12);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.38);
  }
  .foot-social .social-icon-link:focus-visible {
    outline: 2px solid var(--color-blue-bright);
    outline-offset: 3px;
  }
  .foot-social .social-icon-link svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }
  @media (prefers-reduced-motion: reduce) {
    .foot-social .social-icon-link:hover { transform: none; }
  }

  /* Header variant — plain inline icon links */
  .header-social {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .header-social .header-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-cream-2);
    text-decoration: none;
    transition: color 0.15s;
  }
  .header-social .header-icon-link:hover {
    color: var(--color-cream-0);
  }
  .header-social .header-icon-link svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }
</style>
